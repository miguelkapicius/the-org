/* Interface do manager — estilos (USS, o "CSS" da UI Toolkit).
   Direção "mesa de transmissão" (decisão 0025): grafite neutro, superfícies de preenchimento sem borda, tipografia em três vozes
   (Barlow Condensed nos títulos e números grandes, Barlow no texto, IBM Plex Mono nos números de tabela) e UMA cor de ação: claro sobre escuro.
   Laranja = TR e nosso time; azul = CT e o adversário; verde, laranja e vermelho = só estado. Sem gradiente colorido, sem brilho, sem barra lateral.
   ATENÇÃO: a Unity mistura transparência em espaço linear. Um branco escrito com 4 % de opacidade aparece como cinza de 18 %; por isso as
   opacidades deste arquivo já estão convertidas (0,04 vira 0,004). Cor nova com transparência: conferir na captura (CapturarBatch). */

:root {
    --fundo: #0b0d10; --janela: rgba(0, 0, 0, 0); --cartao: rgba(255, 255, 255, 0.004); --cartao2: rgba(255, 255, 255, 0.002); --midia: rgba(255, 255, 255, 0.005); --item: rgba(255, 255, 255, 0.009);
    --linha: rgba(255, 255, 255, 0.008); --linha2: rgba(255, 255, 255, 0.021);
    --texto: #eceef1; --suave: #a4aab4; --apagado: #858c96;
    --destaque: #eceef1; --destaque-claro: #ffffff; --laranja: #f0a640; --azul: #62a8ee; --verde: #4bbf8c; --vermelho: #ec6a5f;
}

/* ---------- base ---------- */
.t { -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-Medium.ttf"); margin: 0; padding: 0; color: var(--texto); font-size: 16px; white-space: nowrap; -unity-text-align: middle-left; }
.quebra { white-space: normal; }
.suave { color: var(--suave); }
.apagado { color: var(--apagado); }
.verde { color: var(--verde); }
.azul { color: var(--azul); }
.laranja { color: var(--laranja); }
.vermelho { color: var(--vermelho); }
.negrito { -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); }
.centro { -unity-text-align: middle-center; }
.direita { -unity-text-align: middle-right; }
.f12 { font-size: 12px; } .f13 { font-size: 13px; } .f14 { font-size: 14px; } .f15 { font-size: 15px; } .f16 { font-size: 16px; }
.f17 { font-size: 17px; } .f18 { font-size: 18px; } .f20 { font-size: 20px; } .f22 { font-size: 22px; } .f24 { font-size: 24px; }
.grow { flex-grow: 1; }
.linha-h { flex-direction: row; align-items: center; }

.tela-raiz { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: var(--fundo); padding: 18px; }
.janela { flex-grow: 1; flex-direction: row; background-color: var(--janela); border-width: 1px; border-color: var(--linha); border-radius: 6px; padding: 12px; overflow: hidden; }

.ic { flex-shrink: 0; color: var(--suave); }

/* ---------- brasão e avatar ---------- */
.brasao { width: 46px; height: 46px; border-radius: 4px; align-items: center; justify-content: center; flex-shrink: 0; }
.brasao.mini-b { width: 38px; height: 38px; border-radius: 19px; }
.brasao.laranja-bg { background-color: #f0a339; }
.brasao.azul-bg { background-color: #6eb4ff; }
.brasao > .t { color: #15151a; font-size: 23px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); -unity-text-align: middle-center; }
.mini-b > .t { font-size: 17px; }

.av { width: 42px; height: 42px; border-radius: 21px; align-items: center; justify-content: center; flex-shrink: 0; }
.av > .t { color: #14141a; font-size: 18px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); -unity-text-align: middle-center; }
.av.grande { width: 92px; height: 92px; border-radius: 46px; }
.av.grande > .t { font-size: 40px; }
.av0 { background-color: #e07a5f; } .av1 { background-color: #3d85c6; } .av2 { background-color: #81b29a; }
.av3 { background-color: #9b72cf; } .av4 { background-color: #f2cc8f; } .av5 { background-color: #5fa8a3; }

/* ---------- menu lateral (cartão) ---------- */
.menu { width: 268px; flex-shrink: 0; background-color: var(--cartao); border-width: 1px; border-color: var(--linha); border-radius: 4px; padding: 14px; margin-right: 12px; }
.clube { flex-direction: row; align-items: center; padding: 4px 6px 22px 6px; }
.clube-nome { flex-grow: 1; margin-left: 12px; }
.menu-nav { flex-grow: 1; }
.item { flex-direction: row; align-items: center; height: 46px; padding: 0 12px 0 10px; border-left-width: 2px; border-left-color: rgba(0, 0, 0, 0); border-radius: 3px; margin-bottom: 3px; }
.item > .ic { margin-right: 12px; }
.item > .t { color: var(--suave); font-size: 17px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); }
.item:hover { background-color: rgba(255, 255, 255, 0.007); }
.item.ativo { background-color: var(--item); border-left-color: var(--destaque); }
.item.ativo > .ic { color: var(--destaque-claro); }
.item.ativo > .t { color: var(--texto); }
.cont { margin-left: auto; min-width: 30px; background-color: rgba(255, 255, 255, 0.01); border-radius: 3px; padding: 2px 9px; align-items: center; }
.item.ativo .cont { background-color: rgba(255, 255, 255, 0.008); }
.cont > .t { font-size: 14px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); -unity-text-align: middle-center; }
.sep { height: 1px; background-color: var(--linha); margin: 10px 4px; }
.proxima { background-color: var(--cartao2); border-width: 1px; border-color: var(--linha); border-radius: 4px; padding: 14px; margin-bottom: 14px; }
.proxima-vs { flex-direction: row; margin: 6px 0 12px 0; }
.rodape { padding: 0 4px; }

/* ---------- telas ---------- */
.tela { flex-grow: 1; min-width: 0; }
.topo { height: 88px; flex-shrink: 0; flex-direction: row; align-items: center; padding: 0 16px 0 20px; border-bottom-width: 1px; border-bottom-color: var(--linha); }
.titulo { flex-grow: 1; }
.titulo-h { font-size: 30px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); }
.usuario { flex-direction: row; align-items: center; }
.usuario-txt { margin-left: 10px; }
.mini-info { align-items: flex-end; margin-right: 20px; }
.corpo { flex-grow: 1; padding: 24px 20px; }
.h2 { font-size: 24px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); margin: 30px 0 14px 0; }
.h2.topo-h2 { margin-top: 0; }
.legenda { color: var(--apagado); font-size: 14px; margin-top: 12px; white-space: normal; }
.secao-linha { flex-direction: row; justify-content: space-between; align-items: center; }

/* ---------- botões, abas, selos ---------- */
.btn { flex-direction: row; align-items: center; justify-content: center; background-color: var(--cartao); border-width: 1px; border-color: var(--linha2); border-radius: 3px; padding: 10px 18px; }
.btn > .t { font-size: 16px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); }
.btn > .ic { margin-right: 8px; color: var(--texto); }
.btn:hover { background-color: rgba(255, 255, 255, 0.012); }
.btn.destaque { background-color: var(--destaque); border-color: var(--destaque); }
.btn.destaque > .t { color: #ffffff; }
.btn.destaque > .ic { color: #ffffff; }
.btn.destaque:hover { background-color: var(--destaque-claro); }
.btn.cheio { padding: 12px 10px; }
.btn.cheio > .t { font-size: 17px; }
.btn.desligado { background-color: rgba(255, 255, 255, 0.002); border-color: rgba(255, 255, 255, 0.007); }
.btn.desligado > .t { color: #565c66; }
.btn.desligado:hover { background-color: rgba(255, 255, 255, 0.002); }

.abas { flex-direction: row; align-self: stretch; border-bottom-width: 1px; border-bottom-color: var(--linha2); margin-bottom: 16px; }
.aba { padding: 9px 2px; margin-right: 26px; margin-bottom: -1px; border-bottom-width: 2px; border-bottom-color: rgba(0, 0, 0, 0); }
.aba > .t { color: var(--suave); font-size: 15px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); }
.aba:hover > .t { color: var(--texto); }
.aba.ativo > .t { color: var(--texto); }

.selo { padding: 4px 10px; border-radius: 4px; align-self: flex-start; background-color: rgba(255, 255, 255, 0.01); }
.selo > .t { font-size: 12px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); color: var(--suave); }
.selo.verde-bg { background-color: rgba(76, 195, 138, 0.035); } .selo.verde-bg > .t { color: var(--verde); }
.selo.laranja-bg { background-color: rgba(240, 170, 70, 0.035); } .selo.laranja-bg > .t { color: var(--laranja); }
.selo.vermelho-bg { background-color: rgba(239, 107, 99, 0.035); } .selo.vermelho-bg > .t { color: var(--vermelho); }

.banner { flex-direction: row; align-items: center; padding: 14px 20px; border-radius: 4px; border-left-width: 5px; margin-bottom: 20px; }
.banner > .t { font-size: 17px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); white-space: normal; }
.banner.ok { background-color: rgba(76, 195, 138, 0.029); border-left-color: var(--verde); }
.banner.erro { background-color: rgba(239, 107, 99, 0.029); border-left-color: var(--vermelho); }

/* ---------- atalhos ---------- */
.atalhos { flex-direction: row; margin-right: -14px; }
.atalho { flex-grow: 1; flex-basis: 0; height: 120px; background-color: var(--cartao2); border-width: 1px; border-color: var(--linha2); border-radius: 4px; padding: 16px; margin-right: 14px; justify-content: space-between; }
.atalho:hover { background-color: rgba(255, 255, 255, 0.008); }
.atalho.destaque { border-color: var(--destaque); }
.atalho.destaque > .ic { color: var(--destaque); }
.atalho-mais { position: absolute; top: 14px; right: 14px; color: var(--apagado); }
.atalho.destaque > .atalho-mais { color: var(--apagado); }
.info-meta { margin-bottom: 10px; }
.pm-aviso { position: absolute; left: 380px; right: 380px; bottom: 140px; margin-bottom: 0; }
.atalho-rot { font-size: 18px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); }

/* ---------- cartões de jogador ---------- */
.fila-cards { flex-direction: row; margin-bottom: 14px; margin-right: -14px; }
.card-j { flex-grow: 1; flex-basis: 0; background-color: var(--cartao); border-width: 1px; border-color: var(--linha); border-radius: 4px; padding: 10px; margin-right: 14px; }
.card-j.vazio { background-color: rgba(0, 0, 0, 0); border-color: rgba(0, 0, 0, 0); }
.midia { height: 170px; background-color: var(--midia); border-radius: 4px; align-items: center; justify-content: center; }
.ovr { position: absolute; top: 8px; right: 8px; width: 40px; height: 40px; border-radius: 20px; background-color: rgba(13, 15, 19, 0.85); border-width: 1px; border-color: var(--linha2); align-items: center; justify-content: center; }
.ovr > .t { font-size: 17px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); -unity-text-align: middle-center; }
.info { padding: 12px 4px 4px 4px; }
.info-nome { font-size: 19px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); }
.attr { flex-direction: row; align-items: center; height: 26px; }
.attr-nome { width: 64px; font-size: 14px; color: var(--suave); }
.attr-num { width: 32px; font-size: 15px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); -unity-text-align: middle-right; }

.barra { height: 8px; border-radius: 4px; background-color: rgba(255, 255, 255, 0.014); flex-grow: 1; }
.barra.fina { height: 6px; border-radius: 3px; }
.fill { height: 100%; border-radius: 4px; }
.fill.verde { background-color: var(--verde); } .fill.azul { background-color: var(--azul); }
.fill.laranja { background-color: var(--laranja); } .fill.vermelho { background-color: var(--vermelho); }

.lista-l { flex-direction: row; align-items: center; height: 56px; border-bottom-width: 1px; border-bottom-color: var(--linha); }
.lista-l > .t { margin-right: 18px; }

/* ---------- tabela ---------- */
.tr { flex-direction: row; align-items: center; height: 68px; padding: 0 8px; border-bottom-width: 1px; border-bottom-color: var(--linha); }
.tr:hover { background-color: rgba(255, 255, 255, 0.005); }
.tr.th { height: 44px; }
.tr.th:hover { background-color: rgba(0, 0, 0, 0); }
.tr.th .t { font-size: 14px; color: var(--apagado); -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-Medium.ttf"); }
.c { flex-direction: row; align-items: center; flex-shrink: 0; }
.c-j { width: 220px; } .c-g { width: 80px; } .c-a { width: 96px; padding-right: 16px; } .c-s { width: 110px; } .c-st { width: 110px; }
.slot.vazio.oculto { border-color: rgba(0, 0, 0, 0); }
.c-k { flex-grow: 1; justify-content: flex-end; }
.c-a-col { flex-direction: column; align-items: stretch; justify-content: center; }
.c-a-col > .barra { flex-grow: 0; margin-top: 5px; }
.pessoa-txt { margin-left: 12px; }
.geral { font-size: 24px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); }
.kebab { width: 36px; height: 36px; border-radius: 4px; align-items: center; justify-content: center; }
.kebab:hover { background-color: var(--item); }
.kebab:hover > .ic { color: var(--texto); }
.kebab.on { background-color: var(--item); }
.dropdown { position: absolute; right: 44px; top: 4px; width: 260px; background-color: rgba(13, 15, 19, 0.92); border-width: 1px; border-color: var(--linha2); border-radius: 4px; padding: 6px; }
.dd-item { flex-direction: row; align-items: center; height: 42px; padding: 0 12px; border-radius: 4px; }
.dd-item > .ic { margin-right: 12px; }
.dd-item > .t { font-size: 16px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); }
.dd-item:hover { background-color: var(--item); }
.dd-item.perigo > .ic { color: var(--vermelho); }
.dd-item.perigo > .t { color: var(--vermelho); }
.dd-item.off > .t { color: #565c66; }
.dd-item.off:hover { background-color: rgba(0, 0, 0, 0); }

/* ---------- finanças e gaming house ---------- */
.resumos { flex-direction: row; margin-bottom: 8px; margin-right: -14px; }
.resumo { flex-grow: 1; flex-basis: 0; background-color: var(--cartao2); border-width: 1px; border-color: var(--linha2); border-radius: 4px; padding: 18px; margin-right: 14px; }
.resumo-valor { font-size: 30px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); margin-top: 8px; }
.cartao { background-color: var(--cartao); border-width: 1px; border-color: var(--linha); border-radius: 4px; padding: 22px; margin-bottom: 18px; }
.cartao-tit { font-size: 14px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); color: var(--suave); margin-bottom: 16px; letter-spacing: 1px; }
.linha-extrato { flex-direction: row; align-items: center; height: 38px; }
.niveis { flex-direction: row; margin-bottom: 20px; }
.nivel { width: 92px; height: 68px; border-radius: 4px; background-color: var(--item); align-items: center; justify-content: center; margin-right: 12px; }
.nivel.tem { background-color: var(--destaque); }
.nivel > .t { font-size: 28px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); color: var(--apagado); -unity-text-align: middle-center; }
.nivel.tem > .t { color: #ffffff; }
.lib { flex-direction: row; align-items: center; height: 46px; }
.lib > .selo { align-self: center; }

/* barra de rolagem fina e discreta (o padrão da Unity é grosso e com setas) */
.unity-scroll-view__vertical-scroller { width: 10px; background-color: rgba(0, 0, 0, 0); border-width: 0; margin-left: 6px; }
.unity-scroller__low-button, .unity-scroller__high-button { display: none; }
.unity-base-slider--vertical .unity-base-slider__tracker, .unity-scroller__slider .unity-base-slider__tracker { background-color: rgba(0, 0, 0, 0); border-width: 0; }
.unity-scroller__slider .unity-base-slider__dragger { background-color: rgba(255, 255, 255, 0.029); border-width: 0; border-radius: 3px; width: 8px; margin-left: 1px; }
.unity-scroller__slider .unity-base-slider__dragger:hover { background-color: rgba(255, 255, 255, 0.066); }
.lib-nome { width: 190px; font-size: 18px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); }

/* ---------- pré-partida ---------- */
.prematch { flex-grow: 1; background-color: #0b0d10; border-radius: 4px; border-width: 2px; border-color: rgba(255, 255, 255, 0.01); overflow: hidden; }
.pm-pixels { position: absolute; left: 0; top: 0; right: 0; height: 260px; }
.pm-relogio { position: absolute; top: 22px; left: 0; right: 0; flex-direction: row; justify-content: center; align-items: center; }
.pm-relogio > .ic { margin-right: 8px; color: var(--texto); }
.pm-relogio > .t { font-size: 20px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); }
.pm-tag { position: absolute; top: 74px; align-items: center; }
.pm-tag.esq { left: 190px; } .pm-tag.dir { right: 190px; }
.pm-tag-nome { flex-direction: row; align-items: center; background-color: rgba(13, 15, 19, 0.85); border-width: 1px; border-color: rgba(255, 255, 255, 0.014); border-radius: 3px; padding: 4px 10px; margin-bottom: 8px; }
.pm-tag-nome > .t { font-size: 17px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); }
.pm-tag-sub { flex-direction: row; align-items: center; }
.pm-tag-sub > .ic { margin-right: 6px; }
.pm-tag-sub > .t { font-size: 13px; color: var(--suave); }

.pm-boneco { position: absolute; width: 640px; height: 860px; bottom: -330px; -unity-background-scale-mode: scale-to-fit; }
.pm-boneco.esq { left: 10px; } .pm-boneco.dir { right: 10px; }

.pm-centro { position: absolute; left: 0; right: 0; top: 96px; flex-direction: row; justify-content: center; align-items: flex-start; }
.pm-time { width: 270px; align-items: center; }
.crest { width: 168px; height: 168px; border-radius: 84px; border-width: 8px; border-color: #f4f4f4; align-items: center; justify-content: center; }
.crest.laranja-bg { background-color: #f0a339; } .crest.azul-bg { background-color: #5aa4f0; }
.crest > .t { font-size: 92px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); color: #15151a; -unity-text-align: middle-center; }
.forca { position: absolute; bottom: -22px; flex-direction: row; align-items: center; background-color: var(--destaque); border-radius: 3px; padding: 2px 10px; }
.forca > .t { font-size: 20px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); color: #ffffff; }
.forca > .ic { margin-left: 4px; color: #ffffff; }
.pm-nome { margin: 30px 0 18px 0; font-size: 38px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); -unity-text-align: middle-center; letter-spacing: 1px; }
.pm-j { flex-direction: row; align-items: center; height: 31px; }
.pm-j-fn { width: 42px; border-width: 1px; border-color: rgba(255, 255, 255, 0.066); border-radius: 4px; margin-right: 10px; align-items: center; }
.pm-j-fn > .t { font-size: 12px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); color: #cfcfd6; -unity-text-align: middle-center; }
.pm-j > .t { font-size: 19px; color: #a9a9b0; letter-spacing: 1px; }
.pm-bola { width: 18px; height: 18px; border-radius: 9px; background-color: rgba(255, 255, 255, 0.014); margin: 76px 8px 0 8px; }

.pm-barra { position: absolute; left: 36px; right: 36px; bottom: 56px; flex-direction: row; justify-content: center; align-items: stretch; }
.seg { flex-direction: row; flex-grow: 1; flex-basis: 0; max-width: 480px; padding: 5px; background-color: rgba(13, 15, 19, 0.85); border-width: 3px; border-color: rgba(255, 255, 255, 0.014); border-radius: 5px; margin: 0 7px; }
.seg-b { flex-grow: 1; flex-basis: 0; height: 58px; border-radius: 4px; background-color: rgba(255, 255, 255, 0.005); border-width: 2px; border-color: rgba(255, 255, 255, 0.014); align-items: center; justify-content: center; margin: 0 2px; }
.seg-b > .t { font-size: 21px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); letter-spacing: 1px; -unity-text-align: middle-center; }
.seg-b:hover { background-color: rgba(255, 255, 255, 0.014); }
.seg-b.desligado > .t { color: #565c66; }
.seg-b.desligado:hover { background-color: rgba(255, 255, 255, 0.005); }
.comecar { width: 290px; flex-direction: row; align-items: center; justify-content: space-between; background-color: var(--destaque); border-width: 3px; border-color: rgba(255, 255, 255, 0.014); border-radius: 5px; padding: 0 24px; margin: 0 7px; }
.comecar:hover { background-color: var(--destaque-claro); }
.comecar > .t { font-size: 21px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); color: #ffffff; letter-spacing: 1px; }
.quad { width: 30px; height: 30px; border-width: 3px; border-color: #ffffff; border-radius: 4px; align-items: center; justify-content: center; }
.quad > .ic { color: #ffffff; }
.comecar.desligado { background-color: rgba(255, 255, 255, 0.062); }

/* ======================================================================================================
   Experiência do manager: avisos, escalação, comparação, prévia, pós-partida, avisos temporários, dicas
   ====================================================================================================== */

/* transições curtas (hover e troca de tela) */
.item, .btn, .atalho, .aba, .kebab, .seg-b, .comecar, .tr, .dd-item, .slot, .aviso-btn, .toast-acao, .cab-ordem {
    transition-property: background-color, border-color, color;
    transition-duration: 120ms;
}
.entra { opacity: 0; transition-property: opacity; transition-duration: 180ms; }
.entra.visivel { opacity: 1; }

/* aviso temporário (no lugar da faixa fixa) */
.toast { position: absolute; right: 36px; bottom: 36px; flex-direction: row; align-items: center; background-color: rgba(13, 15, 19, 0.92); border-width: 1px; border-color: var(--linha2); border-left-width: 5px; border-radius: 4px; padding: 14px 18px; max-width: 620px; }
.toast.ok { border-left-color: var(--verde); }
.toast.erro { border-left-color: var(--vermelho); }
.toast > .t { font-size: 16px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); white-space: normal; }
.toast-acao { margin-left: 18px; padding: 6px 14px; border-radius: 4px; background-color: var(--item); }
.toast-acao:hover { background-color: rgba(255, 255, 255, 0.029); }
.toast-acao > .t { font-size: 14px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); }

/* dica ao passar o mouse */
.dica { position: absolute; background-color: rgba(13, 15, 19, 0.92); border-width: 1px; border-color: var(--linha2); border-radius: 4px; padding: 8px 12px; max-width: 340px; }
.dica > .t { font-size: 14px; white-space: normal; }

/* avisos do painel */
.avisos { background-color: var(--cartao2); border-width: 1px; border-color: var(--linha2); border-radius: 4px; padding: 4px 18px; margin-bottom: 4px; }
.aviso { flex-direction: row; align-items: center; height: 50px; border-top-width: 1px; border-top-color: var(--linha); }
.aviso.primeiro { border-top-width: 0; }
.aviso-ponto { width: 10px; height: 10px; border-radius: 5px; margin-right: 14px; background-color: var(--azul); }
.aviso-ponto.atencao { background-color: var(--laranja); }
.aviso-ponto.critico { background-color: var(--vermelho); }
.aviso-txt { flex-grow: 1; font-size: 16px; }
.aviso-btn { padding: 6px 14px; border-radius: 4px; border-width: 1px; border-color: var(--linha2); background-color: var(--cartao); }
.aviso-btn:hover { background-color: rgba(255, 255, 255, 0.012); }
.aviso-btn > .t { font-size: 14px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); }
.tudo-ok { flex-direction: row; align-items: center; height: 50px; }

/* escalação visual */
.escala { background-color: var(--cartao); border-width: 1px; border-color: var(--linha); border-radius: 4px; padding: 18px; margin-bottom: 24px; }
.escala-topo { flex-direction: row; align-items: center; justify-content: space-between; min-height: 34px; }
.escala-res { flex-direction: row; align-items: center; }
.escala-res > .t { margin-right: 18px; }
.escala-forca { font-size: 26px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); }
.chips-func { flex-direction: row; }
.chip-f { padding: 4px 10px; border-radius: 4px; margin-left: 6px; background-color: rgba(255, 255, 255, 0.01); }
.chip-f > .t { font-size: 12px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); color: var(--suave); }
.chip-f.ok { background-color: rgba(76, 195, 138, 0.029); }
.chip-f.ok > .t { color: var(--verde); }
.chip-f.falta { background-color: rgba(239, 107, 99, 0.035); }
.chip-f.falta > .t { color: var(--vermelho); }
.fila-slots { flex-direction: row; margin-right: -12px; }
.slot { flex-grow: 1; flex-basis: 0; background-color: var(--cartao2); border-width: 1px; border-color: var(--linha2); border-radius: 4px; padding: 12px; margin-right: 12px; align-items: center; }
.slot:hover { background-color: rgba(255, 255, 255, 0.008); }
.slot.sel { border-color: var(--destaque); background-color: rgba(255, 255, 255, 0.023); }
.slot.vazio { background-color: rgba(0, 0, 0, 0); border-color: var(--linha); }
.slot.vazio:hover { background-color: rgba(0, 0, 0, 0); }
.slot-topo { flex-direction: row; justify-content: space-between; align-self: stretch; align-items: center; margin-bottom: 8px; }
.slot-fn { border-width: 1px; border-color: rgba(255, 255, 255, 0.066); border-radius: 4px; padding: 1px 7px; }
.slot-fn > .t { font-size: 12px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); color: #cfcfd6; }
.slot-ovr { font-size: 22px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); }
.slot-nome { font-size: 18px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); margin-top: 8px; }
.banco-tit { margin: 18px 0 10px 0; }
.dica-troca { font-size: 15px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); color: var(--suave); -unity-text-align: middle-right; flex-shrink: 1; }

/* retratos (render 3D do boneco sobre um fundo colorido) */
.retrato { border-radius: 3px; -unity-background-scale-mode: scale-to-fit; align-items: center; justify-content: center; }
.retrato-p { width: 92px; height: 92px; }
.retrato-fill { position: absolute; left: 0; top: 0; right: 0; bottom: 0; border-radius: 4px; }
.retrato > .t { font-size: 36px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); color: #14141a; -unity-text-align: middle-center; }
.rt0 { background-color: rgba(224, 122, 95, 0.086); } .rt1 { background-color: rgba(61, 133, 198, 0.086); } .rt2 { background-color: rgba(129, 178, 154, 0.086); }
.rt3 { background-color: rgba(155, 114, 207, 0.086); } .rt4 { background-color: rgba(242, 204, 143, 0.086); } .rt5 { background-color: rgba(95, 168, 163, 0.086); }

/* comparação de dois jogadores */
.compara { background-color: var(--cartao); border-width: 1px; border-color: var(--linha2); border-radius: 4px; padding: 18px 22px; margin-bottom: 22px; }
.compara-topo { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 10px; }
.cmp-cab { flex-direction: row; align-items: center; margin-bottom: 6px; }
.cmp-lado { flex-grow: 1; flex-basis: 0; flex-direction: row; align-items: center; }
.cmp-lado.dir { justify-content: flex-end; }
.cmp-lado > .t { margin: 0 12px; }
.cmp-meio { width: 130px; }
.cmp-linha { flex-direction: row; align-items: center; height: 34px; border-top-width: 1px; border-top-color: var(--linha); }
.cmp-v { flex-grow: 1; flex-basis: 0; font-size: 18px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); }
.cmp-v.a { -unity-text-align: middle-right; padding-right: 20px; }
.cmp-v.b { -unity-text-align: middle-left; padding-left: 20px; }
.cmp-rot { width: 130px; font-size: 14px; color: var(--suave); -unity-text-align: middle-center; }

/* prévia do efeito no time (mercado) */
.previa { flex-direction: row; align-items: center; background-color: var(--cartao2); border-width: 1px; border-color: var(--linha2); border-radius: 4px; padding: 14px 18px; margin-bottom: 16px; min-height: 64px; }
.previa > .t { white-space: normal; font-size: 16px; flex-grow: 1; flex-shrink: 1; }
.previa.bom { border-color: rgba(76, 195, 138, 0.282); }

/* cabeçalhos de coluna clicáveis (ordenar) */
.cab-ordem { flex-direction: row; align-items: center; border-radius: 3px; padding: 2px 4px; margin-left: -4px; }
.cab-ordem:hover { background-color: rgba(255, 255, 255, 0.007); }
.cab-ordem > .ic { margin-left: 3px; color: var(--destaque); }
.cab-ordem.ativo > .t { color: var(--texto); }

/* botão só com ícone */
.btn-ic { width: 40px; padding: 10px 0; margin-right: 8px; }
.btn-ic > .ic { margin-right: 0; }
.btn-ic.on { background-color: var(--item); border-color: var(--destaque); }

/* pós-partida */
.hero { flex-direction: row; align-items: center; justify-content: space-between; background-color: var(--cartao); border-width: 1px; border-color: var(--linha); border-radius: 4px; padding: 26px 32px; margin-bottom: 18px; }
.hero.venceu { border-color: rgba(76, 195, 138, 0.337); }
.hero.perdeu { border-color: rgba(239, 107, 99, 0.337); }
.hero-res { font-size: 14px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); letter-spacing: 1.5px; }
.hero-placar { font-size: 58px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); }
.hero-meio { align-items: center; }
.c-j.largo { width: 320px; }
.hero-res { margin-bottom: 4px; }
.c-n { width: 104px; }
.c-n > .t { font-size: 17px; }
.c-n.cab > .t { font-size: 14px; color: var(--apagado); }
.nota-estimada { color: var(--laranja); font-size: 15px; margin-bottom: 14px; white-space: normal; }

/* chance de vitória e dicas de teclado na pré-partida */
.pm-chance { position: absolute; left: 50%; margin-left: -260px; width: 520px; top: 545px; align-items: center; }
.pm-chance-tit { font-size: 13px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); color: var(--suave); letter-spacing: 2px; }
.pm-chance-num { font-size: 44px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); -unity-text-align: middle-center; }
.pm-chance-barra { flex-direction: row; height: 10px; align-self: stretch; border-radius: 3px; overflow: hidden; margin: 8px 0 10px 0; background-color: rgba(255, 255, 255, 0.014); }
.pm-chance-a { background-color: var(--laranja); }
.pm-chance-b { background-color: var(--azul); }
.pm-chance-sub { font-size: 14px; color: var(--suave); -unity-text-align: middle-center; white-space: normal; }
.pm-dicas { position: absolute; left: 40px; bottom: 20px; flex-direction: row; }
.pm-dicas-item { flex-direction: row; align-items: center; margin-right: 26px; }
.pm-dicas-item > .t { font-size: 14px; color: #565c66; letter-spacing: 1px; }
.tecla { border-width: 1px; border-color: rgba(255, 255, 255, 0.035); border-radius: 3px; padding: 0 6px; margin-right: 8px; }
.tecla > .t { font-size: 12px; color: var(--apagado); }

/* ======================================================================================================
   Calendário, campeonatos, treino, scouts, preparação da série, Gaming House e finanças (decisões 0012 a 0016)
   ====================================================================================================== */

/* colunas das tabelas com cansaço e potencial */
.c-j { width: 210px; } .c-g { width: 70px; } .c-a { width: 84px; padding-right: 12px; } .c-s { width: 100px; } .c-st { width: 100px; }
.c-f { width: 100px; padding-right: 14px; flex-direction: column; align-items: stretch; justify-content: center; }
.c-f > .barra { flex-grow: 0; margin-top: 5px; }
.c-p { width: 70px; }
.c-foco { width: 150px; }
.c-sess { width: 150px; }
.c-bar { width: 150px; padding-right: 20px; flex-direction: column; align-items: stretch; justify-content: center; }
.c-bar > .barra { flex-grow: 0; margin-top: 5px; }
.c-proj { flex-grow: 1; }

.fill.verde-c { background-color: var(--verde); } .fill.laranja-c { background-color: var(--laranja); } .fill.vermelho-c { background-color: var(--vermelho); }

/* cabeçalho: semana e ação principal */
.chip-semana { flex-direction: row; align-items: center; background-color: var(--cartao); border-width: 1px; border-color: var(--linha2); border-radius: 4px; padding: 8px 16px; margin-right: 14px; }
.chip-semana > .t { font-size: 16px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); }
.chip-semana > .ic { margin-right: 8px; color: var(--suave); }
.topo-acao { margin-right: 14px; }

/* compromisso (painel) */
.compromisso { flex-direction: row; align-items: center; justify-content: space-between; background-color: var(--cartao); border-width: 1px; border-color: var(--linha2); border-radius: 4px; padding: 20px 26px; margin-bottom: 22px; }
.compromisso.agora { border-color: var(--destaque); }
.compromisso-tit { font-size: 13px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); letter-spacing: 1.5px; color: var(--apagado); margin-bottom: 4px; }
.compromisso-nome { font-size: 24px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); }
.compromisso-sub { font-size: 15px; color: var(--suave); margin-top: 3px; }
.compromisso-acoes { flex-direction: row; }
.compromisso-acoes > .btn { margin-left: 10px; }

/* diário */
.diario { background-color: var(--cartao2); border-width: 1px; border-color: var(--linha); border-radius: 4px; padding: 6px 18px; }
.diario-linha { flex-direction: row; align-items: center; height: 42px; border-top-width: 1px; border-top-color: var(--linha); overflow: hidden; }
.diario-linha.primeiro { border-top-width: 0; }
.diario-linha.clicavel-l:hover { background-color: rgba(255, 255, 255, 0.007); }
.diario-linha > .t { font-size: 15px; }

/* faixa das 52 semanas */
.faixa-semanas { flex-direction: row; margin-right: -3px; margin-bottom: 8px; }
.sem-cel { flex-grow: 1; flex-basis: 0; height: 26px; margin-right: 3px; border-radius: 3px; background-color: rgba(255, 255, 255, 0.008); border-width: 1px; border-color: rgba(0, 0, 0, 0); }
.sem-cel.evento { background-color: rgba(255, 255, 255, 0.023); }
.sem-cel.meu { background-color: rgba(240, 170, 70, 0.282); }
.sem-cel.passada { opacity: 0.45; }
.sem-cel.atual { border-color: var(--destaque); }
.legenda-faixa { flex-direction: row; margin-bottom: 20px; }
.legenda-faixa > .t { font-size: 13px; color: var(--apagado); margin-right: 22px; }

/* lista de campeonatos */
.cal-linha { flex-direction: row; align-items: center; height: 66px; border-bottom-width: 1px; border-bottom-color: var(--linha); padding: 0 10px; }
.cal-linha:hover { background-color: rgba(255, 255, 255, 0.005); }
.cal-linha.agora { background-color: rgba(255, 255, 255, 0.014); }
.cal-sem { width: 120px; }
.cal-nome { width: 330px; }
.cal-fmt { width: 190px; }
.cal-st { flex-grow: 1; }
.cal-pos { width: 140px; }

/* detalhe de campeonato */
.rodada-tit { font-size: 15px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); color: var(--suave); margin: 18px 0 8px 0; }
.cf-linha { flex-direction: row; align-items: center; height: 42px; border-bottom-width: 1px; border-bottom-color: var(--linha); padding: 0 12px; }
.cf-linha.meu { background-color: rgba(240, 170, 70, 0.014); }
.cf-a { flex-grow: 1; flex-basis: 0; -unity-text-align: middle-right; }
.cf-b { flex-grow: 1; flex-basis: 0; -unity-text-align: middle-left; }
.cf-placar { width: 90px; -unity-text-align: middle-center; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); font-size: 17px; }
.rk-linha { flex-direction: row; align-items: center; height: 38px; border-bottom-width: 1px; border-bottom-color: var(--linha); padding: 0 12px; }
.rk-linha.meu { background-color: rgba(240, 170, 70, 0.014); }
.rk-pos { width: 50px; color: var(--suave); }
.rk-nome { flex-grow: 1; }
.rk-pts { width: 100px; -unity-text-align: middle-right; }
.duas-colunas { flex-direction: row; }
.coluna { flex-grow: 1; flex-basis: 0; min-width: 0; margin-right: 22px; }
.coluna.ultima { margin-right: 0; }

/* controles pequenos */
.btn-mini { flex-direction: row; align-items: center; justify-content: center; background-color: var(--cartao); border-width: 1px; border-color: var(--linha2); border-radius: 4px; padding: 5px 12px; }
.btn-mini > .t { font-size: 14px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); }
.btn-mini:hover { background-color: rgba(255, 255, 255, 0.012); }
.btn-mini.on { border-color: var(--destaque); background-color: rgba(255, 255, 255, 0.029); }
.btn-mini.desligado > .t { color: #565c66; }
.btn-mini.desligado:hover { background-color: var(--cartao); }
.stepper { flex-direction: row; align-items: center; }
.stepper > .t { width: 34px; font-size: 18px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); -unity-text-align: middle-center; }
.stepper > .btn-ic { margin-right: 0; width: 34px; padding: 6px 0; }

/* treino */
.treino-topo { flex-direction: row; margin-bottom: 20px; margin-right: -14px; }
.treino-card { flex-grow: 1; flex-basis: 0; background-color: var(--cartao2); border-width: 1px; border-color: var(--linha2); border-radius: 4px; padding: 16px 18px; margin-right: 14px; }
.treino-card.bloq { opacity: 0.55; }
.treino-card-tit { font-size: 13px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); letter-spacing: 1.2px; color: var(--apagado); margin-bottom: 8px; }
.efeito-time { flex-direction: row; align-items: center; background-color: var(--cartao); border-width: 1px; border-color: var(--linha2); border-radius: 4px; padding: 14px 18px; margin-top: 16px; }
.efeito-time > .t { white-space: normal; font-size: 16px; }
.presets { flex-direction: row; margin-bottom: 14px; }
.presets > .btn-mini { margin-right: 8px; }

/* scouts */
.scout-card { background-color: var(--cartao2); border-width: 1px; border-color: var(--linha2); border-radius: 4px; padding: 16px 18px; margin-bottom: 12px; }
.scout-topo { flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 10px; }
.tarefas { flex-direction: row; flex-wrap: wrap; }
.tarefas > .btn-mini { margin-right: 8px; margin-bottom: 8px; }
.intel-card { background-color: var(--cartao); border-width: 1px; border-color: var(--linha); border-radius: 4px; padding: 18px 20px; margin-bottom: 14px; }
.intel-topo { flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 10px; }
.intel-nivel { flex-direction: row; }
.intel-nivel > .pip { width: 22px; height: 8px; border-radius: 4px; background-color: rgba(255, 255, 255, 0.014); margin-left: 4px; }
.intel-nivel > .pip.on { background-color: var(--destaque); }
.mb-linha { flex-direction: row; align-items: center; height: 28px; }
.mb-nome { width: 110px; font-size: 14px; color: var(--suave); }
.mb-num { width: 36px; font-size: 14px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); -unity-text-align: middle-right; }
.oculto-txt { color: var(--apagado); font-size: 15px; }

/* preparação da série: veto de mapas e estratégia */
.pool { flex-direction: row; margin-right: -12px; margin-bottom: 18px; }
.mapa-card { flex-grow: 1; flex-basis: 0; background-color: var(--cartao); border-width: 1px; border-color: var(--linha2); border-radius: 4px; padding: 12px; margin-right: 12px; min-height: 170px; }
.mapa-card.livre:hover { background-color: rgba(255, 255, 255, 0.012); }
.mapa-card.clicavel { border-color: var(--suave); }
.mapa-card.banido { opacity: 0.4; }
.mapa-card.escolha-nos { border-color: var(--laranja); background-color: rgba(240, 170, 70, 0.01); }
.mapa-card.escolha-eles { border-color: var(--azul); background-color: rgba(110, 180, 255, 0.01); }
.mapa-card.decisivo { border-color: var(--destaque); }
.mapa-nome { font-size: 18px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); margin-bottom: 2px; }
.mapa-tag { font-size: 12px; color: var(--apagado); margin-bottom: 10px; }
.mapa-af { flex-direction: row; align-items: center; height: 22px; }
.mapa-af > .t { font-size: 13px; color: var(--suave); width: 38px; }
.mapa-af > .barra { height: 6px; }
.mapa-af > .num { width: 30px; font-size: 13px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); -unity-text-align: middle-right; }
.mapa-estado { margin-top: 10px; }
.ordem-mapas { flex-direction: row; margin-bottom: 18px; }
.ordem-mapas > .selo { margin-right: 8px; }
.estilos { margin-bottom: 14px; }
.estilo-card { background-color: var(--cartao); border-width: 1px; border-color: var(--linha2); border-radius: 4px; padding: 12px 16px; margin-bottom: 8px; }
.estilo-card:hover { background-color: rgba(255, 255, 255, 0.01); }
.estilo-card.sel { border-color: var(--destaque); background-color: rgba(255, 255, 255, 0.023); }
.estilo-topo { flex-direction: row; align-items: center; justify-content: space-between; }
.estilo-nome { font-size: 17px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); }
.estilo-desc { font-size: 14px; color: var(--suave); white-space: normal; margin-top: 3px; }
.resumo-serie { flex-direction: row; margin-right: -14px; margin-bottom: 18px; }
.resumo-serie > .resumo { margin-right: 14px; }

/* Gaming House */
.gh-nivel { background-color: var(--cartao); border-width: 1px; border-color: var(--linha); border-radius: 4px; padding: 18px 22px; margin-bottom: 14px; }
.gh-nivel.atual { border-color: var(--destaque); }
.gh-nivel.feito { opacity: 0.75; }
.gh-topo { flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 8px; }
.gh-num { width: 40px; height: 40px; border-radius: 20px; background-color: var(--item); align-items: center; justify-content: center; margin-right: 14px; }
.gh-num > .t { font-size: 18px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); -unity-text-align: middle-center; }
.gh-nivel.atual .gh-num { background-color: var(--destaque); }
.gh-nivel.atual .gh-num > .t { color: #ffffff; }
.gh-vant { flex-direction: row; align-items: center; height: 28px; }
.gh-vant > .t { font-size: 15px; }
.gh-ponto { width: 6px; height: 6px; border-radius: 3px; background-color: var(--suave); margin-right: 12px; }
.gh-nivel.atual .gh-ponto { background-color: var(--destaque); }
.gh-rodape { flex-direction: row; align-items: center; justify-content: space-between; margin-top: 10px; }

/* empréstimo */
.emp-linha { flex-direction: row; align-items: center; height: 54px; border-bottom-width: 1px; border-bottom-color: var(--linha); }
.emp-linha > .t { margin-right: 24px; }
.valores-emp { flex-direction: row; margin-top: 10px; }
.valores-emp > .btn-mini { margin-right: 8px; }
.fluxo { flex-direction: row; align-items: center; height: 36px; }
.fluxo > .t { font-size: 16px; }
.fluxo-rot { width: 260px; }
.fluxo-val { width: 130px; margin-right: 22px; -unity-text-align: middle-right; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); }
.resumo-valor.menor { font-size: 21px; white-space: normal; margin-top: 12px; }


/* ======================================================================================================
   Hub (cartões de vidro com a ação em destaque) e abas em destaque
   ====================================================================================================== */
.hub { flex-direction: row; margin-right: -16px; margin-bottom: 30px; }
.hub-card { flex-grow: 1; flex-basis: 0; height: 340px; background-color: var(--cartao); -unity-background-scale-mode: scale-and-crop; border-width: 1px; border-color: var(--linha2); border-radius: 6px; margin-right: 16px; overflow: hidden; transition-property: border-color, translate; transition-duration: 160ms; }
.hub-card:hover { border-color: rgba(255, 255, 255, 0.149); translate: 0 -3px; }
.hub-card.destaque { border-width: 2px; border-color: var(--destaque); }
.hub-card.destaque:hover { border-color: var(--destaque-claro); }
.hub-veu { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.hub-card .ic { color: #ffffff; }
.hub-selo { position: absolute; top: 12px; right: 12px; min-width: 34px; height: 30px; border-radius: 4px; background-color: rgba(13, 15, 19, 0.85); align-items: center; justify-content: center; padding: 0 9px; }
.hub-selo > .t { color: #ffffff; font-size: 16px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); -unity-text-align: middle-center; }
.hub-corpo { flex-grow: 1; justify-content: flex-end; padding: 0 20px 20px 20px; }
.hub-tit { color: #ffffff; font-size: 25px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); white-space: normal; letter-spacing: 1px; }
.hub-sub { color: #b9bec7; font-size: 15px; white-space: normal; margin-top: 4px; }
.hub-btn { flex-direction: row; align-items: center; justify-content: space-between; margin-top: 16px; background-color: var(--destaque); border-radius: 4px; padding: 12px 16px; }
.hub-btn > .t { color: #ffffff; font-size: 16px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); letter-spacing: 1px; }
.hub-btn > .ic { color: #ffffff; }
.hub-btn:hover { background-color: var(--destaque-claro); }

.aba.ativo { border-bottom-color: var(--destaque); }
.aba.ativo > .t { color: #ffffff; }


/* ======================================================================================================
   Calendário mensal (grade de mês com datas reais)
   ====================================================================================================== */
.cal-topo { flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 14px; }
.cal-nav { flex-direction: row; align-items: center; }
.cal-nav > .btn-ic { margin-right: 0; }
.cal-mes { font-size: 28px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); min-width: 250px; -unity-text-align: middle-center; }
.gira-esq > .ic, .gira-dir > .ic { rotate: -90deg; }   /* a seta para cima vira esquerda; a para baixo vira direita */
.cal-grade { background-color: var(--cartao); border-width: 1px; border-color: var(--linha); border-radius: 4px; overflow: hidden; }
.cal-dias-sem { flex-direction: row; height: 38px; border-bottom-width: 1px; border-bottom-color: var(--linha); background-color: var(--cartao2); }
.cal-dias-sem > .t { flex-grow: 1; flex-basis: 0; -unity-text-align: middle-center; color: var(--apagado); font-size: 13px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); letter-spacing: 1px; }
.cal-semana { flex-direction: row; height: 96px; border-bottom-width: 1px; border-bottom-color: var(--linha); border-left-width: 3px; border-left-color: rgba(0, 0, 0, 0); }
.cal-semana.atual { border-left-color: var(--destaque); }
.cal-semana.atual .cal-dia { background-color: rgba(255, 255, 255, 0.008); }
.cal-semana.atual .cal-dia.camp { background-color: rgba(255, 255, 255, 0.018); }
.cal-dia { flex-grow: 1; flex-basis: 0; padding: 6px 7px; border-right-width: 1px; border-right-color: var(--linha); overflow: hidden; }
.cal-dia.fora { opacity: 0.32; }
.cal-dia.passada { opacity: 0.62; }
.cal-dia.camp { background-color: rgba(240, 170, 70, 0.008); }
.cal-num { font-size: 14px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); color: var(--suave); margin-right: 6px; }
.cal-tag { font-size: 12px; color: var(--laranja); -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); overflow: hidden; text-overflow: ellipsis; flex-shrink: 1; }
.cal-chip { flex-direction: row; align-items: center; border-radius: 3px; padding: 2px 7px; margin-top: 4px; border-width: 1px; border-color: rgba(0, 0, 0, 0); }
.cal-chip > .t { font-size: 12px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); overflow: hidden; text-overflow: ellipsis; }
.cal-chip.pend { background-color: rgba(240, 170, 70, 0.042); border-color: var(--laranja); }
.cal-chip.pend > .t { color: var(--laranja); }
.cal-chip.venceu { background-color: rgba(76, 195, 138, 0.042); }
.cal-chip.venceu > .t { color: var(--verde); }
.cal-chip.perdeu { background-color: rgba(239, 107, 99, 0.042); }
.cal-chip.perdeu > .t { color: var(--vermelho); }
.cal-chip.camp-leg { background-color: rgba(240, 170, 70, 0.008); border-color: rgba(240, 170, 70, 0.062); }
.cal-chip.camp-leg > .t { color: var(--suave); }
.legenda-cal { flex-direction: row; align-items: center; flex-wrap: wrap; margin-top: 12px; }
.legenda-cal > .cal-chip { margin-top: 0; margin-right: 10px; }
.legenda-cal > .t { font-size: 13px; color: var(--apagado); }
.cal-lateral { width: 310px; flex-shrink: 0; margin-left: 20px; background-color: var(--cartao2); border-width: 1px; border-color: var(--linha2); border-radius: 4px; padding: 16px 16px 10px 16px; }
.prox-item { background-color: var(--cartao); border-width: 1px; border-color: var(--linha); border-radius: 3px; padding: 10px 12px; margin-bottom: 8px; }
.prox-item:hover { background-color: rgba(255, 255, 255, 0.012); }
.prox-resumo { margin-top: 6px; padding-top: 10px; border-top-width: 1px; border-top-color: var(--linha); }


/* ======================================================================================================
   Elenco só em cartões: selo de status, botões à vista
   ====================================================================================================== */
.midia-selo { position: absolute; left: 8px; top: 8px; }
.card-j.comp { border-color: var(--azul); }
.card-acoes { flex-direction: row; align-items: center; margin-top: 12px; padding: 0 4px 2px 4px; }
.card-acoes > .btn-mini { margin-right: 6px; }
.btn-mini.perigo > .t { color: var(--vermelho); }
.btn-mini.perigo > .ic { color: var(--vermelho); }
.btn-mini.perigo.desligado > .t { color: #565c66; }


/* ======================================================================================================
   Elenco enxuto (decisão 0023): estado em palavras, ação principal larga, ações secundárias só com ícone
   ====================================================================================================== */
.estado { flex-direction: row; flex-wrap: wrap; margin-bottom: 8px; }
.estado > .selo { margin-right: 6px; margin-bottom: 4px; }
.card-acoes > .btn-mini.grow { flex-grow: 1; }
.btn-mini.destaque { background-color: var(--destaque); border-color: var(--destaque); }
.btn-mini.destaque:hover { background-color: var(--destaque-claro); }
.btn-mini.so-ic { width: 34px; padding: 5px 0; }
.btn-mini.so-ic > .ic { margin-right: 0; }
.btn-mini.so-ic > .t { display: none; }
.card-acoes > .btn-mini.so-ic { margin-right: 0; margin-left: 6px; }

/* ======================================================================================================
   Telas enxutas (decisão 0023): conclusão no topo do treino, níveis fechados da Gaming House, chance da série
   ====================================================================================================== */
.efeito-time { margin-top: 0; margin-bottom: 16px; border-left-width: 4px; }
.efeito-time > .t { font-size: 17px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); }
.efeito-time.bom { border-left-color: var(--verde); }
.efeito-time.neutro { border-left-color: var(--azul); }
.efeito-time.ruim { border-left-color: var(--vermelho); }
.presets { align-items: center; }
.gh-nivel.fechado { padding: 12px 22px; margin-bottom: 8px; }
.gh-nivel.fechado > .gh-topo { margin-bottom: 0; }
.gh-nivel.fechado .gh-num { width: 32px; height: 32px; border-radius: 16px; }
.mapa-card { min-height: 0; }
.serie-chance { font-size: 44px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); -unity-text-align: middle-right; }

/* ---- treino do jogador (decisão 0024): foto grande à direita, números à esquerda, tabela por lado embaixo ---- */
.c-lado { width: 110px; }
.tj-nav { flex-direction: row; flex-wrap: wrap; margin-bottom: 14px; }
.tj-nav > .btn-mini { margin-right: 8px; margin-bottom: 6px; }
.tj-hero { flex-shrink: 0; height: 580px; background-color: rgba(255, 255, 255, 0.002); border-width: 1px; border-color: var(--linha2); border-radius: 4px; overflow: hidden; }
.tj-foto { position: absolute; right: 0; top: 0; bottom: 0; width: 46%; -unity-background-scale-mode: scale-and-crop; }
.tj-veu { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.tj-lado-foto { position: absolute; right: 18px; top: 18px; }
.tj-info { position: absolute; left: 34px; top: 26px; width: 44%; }
.tj-pre { font-size: 15px; color: var(--suave); letter-spacing: 1px; }
.tj-nome { font-size: 58px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); color: #ffffff; letter-spacing: 1px; margin-top: 2px; }
.tj-sub { width: 200px; height: 2px; background-color: var(--destaque); margin-top: 12px; margin-bottom: 14px; }
.tj-nums { flex-direction: row; }
.tj-num { margin-right: 36px; }
.tj-num-v { font-size: 38px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); }
.tj-dado { flex-direction: row; align-items: center; margin-bottom: 7px; }
.tj-dado-rot { width: 100px; }
.tj-faixa { position: absolute; left: 0; right: 0; bottom: 0; background-color: rgba(9, 11, 14, 0.84); border-top-width: 1px; border-top-color: var(--linha2); }
.tj-linha-tab { flex-direction: row; align-items: center; height: 54px; padding: 0 28px; border-bottom-width: 1px; border-bottom-color: var(--linha); }
.tj-linha-tab.cab { height: 36px; }
.tj-linha-tab.cab .t { font-size: 13px; color: var(--apagado); -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-Medium.ttf"); }
.tj-linha-tab:hover { background-color: rgba(255, 255, 255, 0.004); }
.tj-linha-tab.cab:hover { background-color: rgba(0, 0, 0, 0); }
.tj-c-rot { width: 210px; }
.tj-c-num { width: 118px; justify-content: center; }
.tj-valor { font-size: 22px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); }
.tj-rot-lado { justify-content: center; }
.tj-plano-linha { flex-direction: row; align-items: center; margin-bottom: 8px; }
.tj-plano-rot { width: 90px; }
.midia-lado { position: absolute; left: 8px; bottom: 8px; }
.tj-plano { flex-grow: 0; flex-basis: auto; flex-shrink: 0; margin-right: 0; }
.efeito-time { flex-shrink: 0; }


/* ======================================================================================================
   Refino "mesa de transmissão" (decisão 0025). Esta camada vem por último e vale sobre as regras acima.
   ====================================================================================================== */

/* ---- as três vozes tipográficas ---- */
.titulo-h, .h2, .hub-tit, .compromisso-nome, .tj-nome, .hero-placar, .serie-chance, .escala-forca, .resumo-valor, .pm-nome, .cal-mes,
.info-nome, .slot-nome, .tj-num-v, .pm-chance-num, .ovr > .t, .lib-nome, .mapa-nome, .estilo-nome, .nivel > .t, .gh-num > .t, .crest > .t, .brasao > .t, .atalho-rot {
    -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/BarlowCondensed-SemiBold.ttf");
}
.attr-num, .tj-valor, .c-n > .t, .cf-placar, .rk-pts, .fluxo-val, .cont > .t, .mb-num, .mapa-af > .num, .stepper > .t, .slot-ovr, .geral, .dado-val, .cal-num {
    -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/IBMPlexMono-Medium.ttf");
}
.c-n.cab > .t { -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-Medium.ttf"); }
.titulo-h { font-size: 40px; }
.h2 { font-size: 27px; margin: 36px 0 14px 0; }
.hub-tit { font-size: 36px; letter-spacing: 0.5px; }
.compromisso-nome { font-size: 31px; }
.tj-nome { font-size: 76px; letter-spacing: 0; }
.hero-placar { font-size: 76px; }
.serie-chance { font-size: 60px; }
.escala-forca { font-size: 36px; }
.resumo-valor { font-size: 38px; }
.pm-nome { font-size: 48px; }
.cal-mes { font-size: 36px; }
.info-nome { font-size: 25px; }
.slot-nome { font-size: 23px; }
.tj-num-v { font-size: 46px; }
.pm-chance-num { font-size: 58px; }
.mapa-nome, .estilo-nome, .lib-nome { font-size: 22px; }
.nivel > .t { font-size: 36px; }
.gh-num > .t { font-size: 22px; }
.crest > .t { font-size: 104px; }
.brasao > .t { font-size: 27px; }
.attr-num { font-size: 15px; width: 34px; }
.geral, .slot-ovr { font-size: 20px; }
.tj-valor { font-size: 21px; }
.cal-num { font-size: 13px; }

/* rótulos pequenos em caixa-alta */
.compromisso-tit, .treino-card-tit, .cartao-tit, .pm-chance-tit, .hero-res, .dado-rot, .rodada-tit {
    font-size: 12px; letter-spacing: 1.6px; color: var(--apagado);
    -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf");
}
.tr.th .t, .tj-linha-tab.cab .t { font-size: 12px; letter-spacing: 0.8px; color: var(--apagado); }

/* ---- estrutura: o app ocupa a tela, sem janela dentro de moldura ---- */
.tela-raiz { padding: 0; }
.janela { background-color: rgba(0, 0, 0, 0); border-width: 0; border-radius: 0; padding: 0; }
.menu { width: 252px; background-color: rgba(255, 255, 255, 0.002); border-width: 0; border-right-width: 1px; border-right-color: var(--linha); border-radius: 0; padding: 24px 14px 16px 14px; margin-right: 0; }
.clube { padding: 0 8px 28px 8px; }
.brasao { width: 40px; height: 40px; border-radius: 3px; }
.item { height: 40px; padding: 0 10px; border-left-width: 0; border-radius: 3px; margin-bottom: 2px; }
.item > .t { font-size: 16px; color: var(--suave); -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-Medium.ttf"); }
.item > .ic { margin-right: 12px; color: var(--apagado); }
.item:hover > .t { color: var(--texto); }
.item.ativo { background-color: rgba(255, 255, 255, 0.009); }
.item.ativo > .t { color: #ffffff; }
.item.ativo > .ic { color: #ffffff; }
.cont, .item.ativo .cont { background-color: rgba(0, 0, 0, 0); padding: 0; min-width: 0; }
.cont > .t { font-size: 13px; color: var(--apagado); }
.sep { margin: 12px 10px; }
.proxima { background-color: rgba(255, 255, 255, 0.004); border-color: rgba(0, 0, 0, 0); }
.topo { height: 88px; padding: 0 32px; }
.corpo { padding: 30px 32px 40px 32px; }
.dado-topo { align-items: flex-end; margin-left: 38px; }
.dado-val { font-size: 21px; color: var(--texto); margin-top: 2px; }

/* ---- botões: uma ação principal clara; o resto é contorno ---- */
.btn { background-color: rgba(0, 0, 0, 0); border-color: var(--linha2); border-radius: 3px; padding: 9px 18px; }
.btn > .t { font-size: 15px; }
.btn:hover { background-color: rgba(255, 255, 255, 0.008); border-color: rgba(255, 255, 255, 0.086); }
.btn.destaque, .btn-mini.destaque { background-color: #eceef1; border-color: #eceef1; }
.btn.destaque > .t, .btn.destaque > .ic, .btn-mini.destaque > .t, .btn-mini.destaque > .ic { color: #0b0d10; }
.btn.destaque:hover, .btn-mini.destaque:hover { background-color: #ffffff; border-color: #ffffff; }
.btn.cheio > .t { font-size: 16px; }
.btn.desligado, .btn.desligado:hover { background-color: rgba(255, 255, 255, 0.002); border-color: rgba(255, 255, 255, 0.007); }
.btn-mini { background-color: rgba(0, 0, 0, 0); border-color: var(--linha2); border-radius: 3px; padding: 4px 11px; }
.btn-mini > .t { font-size: 14px; color: var(--suave); -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-Medium.ttf"); }
.btn-mini > .ic { color: var(--suave); }
.btn-mini:hover { background-color: rgba(255, 255, 255, 0.008); }
.btn-mini:hover > .t, .btn-mini:hover > .ic { color: var(--texto); }
.btn-mini.on { border-color: rgba(255, 255, 255, 0.282); background-color: rgba(255, 255, 255, 0.014); }
.btn-mini.on > .t, .btn-mini.on > .ic { color: #ffffff; }
.btn-mini.destaque > .t { -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); }
.btn-mini.desligado:hover { background-color: rgba(0, 0, 0, 0); }
.btn-mini.desligado > .t, .btn-mini.desligado:hover > .t, .btn-mini.desligado > .ic { color: #565c66; }
.btn-mini.perigo > .t, .btn-mini.perigo > .ic { color: var(--vermelho); }
.btn-ic.on { border-color: rgba(255, 255, 255, 0.282); background-color: rgba(255, 255, 255, 0.014); }
.aba > .t { -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-Medium.ttf"); }
.aba.ativo { border-bottom-color: #eceef1; }

/* ---- selos e barras ---- */
.selo { padding: 3px 8px; border-radius: 2px; background-color: rgba(255, 255, 255, 0.008); }
.selo > .t { font-size: 12px; letter-spacing: 1px; }
.selo.verde-bg { background-color: rgba(75, 191, 140, 0.026); } .selo.laranja-bg { background-color: rgba(240, 166, 64, 0.026); } .selo.vermelho-bg { background-color: rgba(236, 106, 95, 0.026); }
.selo.azul-bg { background-color: rgba(98, 168, 238, 0.026); } .selo.azul-bg > .t { color: var(--azul); }
.barra { height: 4px; border-radius: 2px; background-color: rgba(255, 255, 255, 0.012); }
.barra.fina { height: 3px; border-radius: 2px; }
.fill { border-radius: 2px; }

/* ---- superfícies: preenchimento sem borda; borda só quando algo está escolhido ---- */
.cartao, .card-j, .treino-card, .scout-card, .intel-card, .gh-nivel, .escala, .compara, .hero, .compromisso, .previa, .efeito-time, .resumo, .atalho,
.cal-lateral, .avisos, .diario, .slot, .estilo-card, .mapa-card, .cal-grade, .prox-item, .tj-hero, .chip-semana, .aviso-btn { border-color: rgba(0, 0, 0, 0); }
.card-j, .treino-card, .scout-card, .intel-card, .gh-nivel, .escala, .compara, .hero, .compromisso, .previa, .efeito-time, .cartao { background-color: rgba(255, 255, 255, 0.004); }
.slot, .estilo-card, .mapa-card { background-color: rgba(255, 255, 255, 0.004); }
.card-j.comp { border-color: rgba(255, 255, 255, 0.232); }
.slot.sel, .estilo-card.sel { border-color: rgba(255, 255, 255, 0.282); background-color: rgba(255, 255, 255, 0.01); }
.mapa-card.clicavel { border-color: rgba(255, 255, 255, 0.115); }
.mapa-card.decisivo, .gh-nivel.atual, .compromisso.agora { border-color: rgba(255, 255, 255, 0.232); }
.hero.venceu { border-color: rgba(75, 191, 140, 0.337); } .hero.perdeu { border-color: rgba(236, 106, 95, 0.337); }
.previa.bom { border-color: rgba(75, 191, 140, 0.232); }
.cal-semana.atual { border-left-color: #eceef1; }
.cal-semana.atual .cal-dia { background-color: rgba(255, 255, 255, 0.004); }
.cal-linha.agora { background-color: rgba(255, 255, 255, 0.005); }
.card-j .midia, .retrato-fill { border-radius: 3px; }
.ovr { width: 38px; height: 38px; border-radius: 3px; border-width: 0; background-color: rgba(9, 11, 14, 0.78); }
.ovr > .t { font-size: 25px; }

/* conclusões em faixa de cor suave, sem barra lateral */
.efeito-time { border-left-width: 1px; }
.efeito-time.bom { background-color: rgba(75, 191, 140, 0.014); border-color: rgba(75, 191, 140, 0.115); }
.efeito-time.neutro { background-color: rgba(98, 168, 238, 0.014); border-color: rgba(98, 168, 238, 0.115); }
.efeito-time.ruim { background-color: rgba(236, 106, 95, 0.014); border-color: rgba(236, 106, 95, 0.149); }
.efeito-time > .t { font-size: 17px; }
.banner { border-left-width: 0; }
.toast { border-left-width: 1px; border-radius: 3px; }
.toast.ok { border-color: rgba(75, 191, 140, 0.282); } .toast.erro { border-color: rgba(236, 106, 95, 0.337); }

/* pessoas: sem cor de enfeite, o avatar é neutro */
.av0, .av1, .av2, .av3, .av4, .av5 { background-color: rgba(255, 255, 255, 0.012); }
.av > .t { color: var(--suave); }
.rt0, .rt1, .rt2, .rt3, .rt4, .rt5 { background-color: rgba(255, 255, 255, 0.007); }

/* ---- hub: arte limpa, título condensado, sem "pulo" no hover ---- */
.hub-card { height: 360px; border-width: 1px; border-color: rgba(0, 0, 0, 0); border-radius: 4px; }
.hub-card:hover { border-color: rgba(255, 255, 255, 0.149); translate: 0 0; }
.hub-card.destaque { border-width: 1px; border-color: rgba(255, 255, 255, 0.232); }
.hub-card.destaque:hover { border-color: #ffffff; }
.hub-sub { font-size: 15px; color: #b9bec7; margin-top: 2px; }
.hub-btn { background-color: #eceef1; border-radius: 3px; padding: 11px 16px; }
.hub-card .hub-btn > .t, .hub-card .hub-btn > .ic { color: #0b0d10; }
.hub-btn:hover { background-color: #ffffff; }

/* ---- onde havia cor de marca, agora claro sobre escuro ---- */
.nivel.tem, .gh-nivel.atual .gh-num { background-color: #eceef1; }
.nivel.tem > .t, .gh-nivel.atual .gh-num > .t { color: #0b0d10; }
.gh-nivel.atual .gh-ponto, .intel-nivel > .pip.on { background-color: #eceef1; }
.forca { background-color: #eceef1; }
.forca > .t, .forca > .ic { color: #0b0d10; }
.comecar { background-color: #eceef1; }
.comecar:hover { background-color: #ffffff; }
.comecar > .t, .quad > .ic { color: #0b0d10; }
.quad { border-color: #0b0d10; }
.comecar.desligado { background-color: rgba(236, 238, 241, 0.049); }
.cab-ordem > .ic { color: var(--texto); }

/* ---- ficha do jogador ---- */
.tj-hero { background-color: rgba(255, 255, 255, 0.002); }
.tj-sub { width: 44px; height: 2px; background-color: rgba(255, 255, 255, 0.282); }
.tj-pre { font-size: 15px; letter-spacing: 1.2px; }
.tj-info { top: 30px; }
.tj-linha-tab { height: 52px; }

/* ---- acertos depois da primeira captura ---- */
.selo > .t { letter-spacing: 0; font-size: 12px; }
.aviso-linha { margin-bottom: 10px; }
.retrato.foto, .tj-foto { background-size: cover; background-position: center top; -unity-background-scale-mode: scale-and-crop; }
.tj-hero { background-color: rgba(0, 0, 0, 0); border-color: var(--linha2); }
.mapa-card.clicavel { border-color: rgba(255, 255, 255, 0.12); }
.compromisso.agora, .mapa-card.decisivo, .gh-nivel.atual { border-color: rgba(255, 255, 255, 0.14); }
.seg { border-width: 1px; padding: 4px; border-radius: 4px; }
.seg-b { border-width: 0; background-color: rgba(255, 255, 255, 0.012); border-radius: 3px; }
.seg-b:hover { background-color: rgba(255, 255, 255, 0.03); }
.comecar { border-width: 0; border-radius: 4px; }
.pm-tag-nome { border-radius: 3px; }


/* ======================================================================================================
   Segunda rodada: menu em barra de ícones, caixinha da conta, vitrine do mercado e correção de textos que se encavalavam
   (as opacidades continuam escritas já convertidas para a mistura linear)
   ====================================================================================================== */

/* padrão de fundo (mapa topográfico com grade tática, gerado no Figma), bem apagado */
.tela-raiz { background-image: url("/Assets/Resources/ManagerUI/fundo.jpg"); background-size: cover; background-position: center center; -unity-background-image-tint-color: rgb(80, 80, 84); }

/* menu: barra estreita só de ícones */
.menu { width: 76px; padding: 20px 0 16px 0; align-items: center; background-color: #08090c; border-right-width: 1px; border-right-color: rgba(255, 255, 255, 0.02); }
.menu-logo { margin-bottom: 28px; }
.menu-nav { flex-grow: 1; align-items: center; }
.menu-rodape { align-items: center; }
.item { width: 46px; height: 46px; padding: 0; margin-bottom: 8px; justify-content: center; align-items: center; border-radius: 6px; }
.item > .ic { margin-right: 0; color: var(--apagado); }
.item:hover > .ic { color: var(--texto); }
.item.ativo { background-color: rgba(255, 255, 255, 0.02); }
.item.ativo > .ic { color: #ffffff; }
.item-ponto { position: absolute; top: 9px; right: 9px; width: 8px; height: 8px; border-radius: 4px; background-color: var(--laranja); }
.sep { width: 28px; height: 1px; margin: 8px 0 16px 0; }
.menu-acao { width: 46px; height: 46px; border-radius: 6px; background-color: #eceef1; align-items: center; justify-content: center; margin-bottom: 10px; }
.menu-acao > .ic { color: #0b0d10; }
.menu-acao:hover { background-color: #ffffff; }
.menu-acao.desligado, .menu-acao.desligado:hover { background-color: rgba(255, 255, 255, 0.012); }
.menu-acao.desligado > .ic { color: #565c66; }
.item-nova.perigo > .ic { color: var(--vermelho); }

/* saldo como uma "conta" dentro de uma caixinha (referência: Wallet connect) */
.carteira { flex-direction: row; align-items: center; margin-left: 28px; padding: 6px 16px 6px 7px; border-width: 1px; border-color: rgba(255, 255, 255, 0.035); border-radius: 5px; background-color: rgba(255, 255, 255, 0.006); }
.carteira-ic { width: 34px; height: 34px; border-radius: 4px; background-color: rgba(255, 255, 255, 0.014); align-items: center; justify-content: center; margin-right: 12px; }
.carteira-ic > .ic { color: var(--texto); }
.carteira-txt { align-items: flex-start; }
.carteira .dado-val { margin-top: 0; }

/* mercado em vitrine */
.vit-tops { flex-direction: row; flex-wrap: wrap; margin-bottom: 4px; }
.vit-top { align-items: center; width: 92px; margin-right: 12px; margin-bottom: 8px; }
.vit-top-foto { width: 68px; height: 68px; border-radius: 34px; margin-bottom: 8px; }
.vit-filtros { flex-direction: row; flex-wrap: wrap; justify-content: space-between; align-items: flex-start; margin: 24px 0 14px 0; }
.vit-ordem { align-items: center; }
.vit-grade { flex-direction: row; flex-wrap: wrap; }
.vit-card { width: 23.8%; margin-right: 1%; margin-bottom: 14px; background-color: rgba(255, 255, 255, 0.008); border-width: 1px; border-color: rgba(0, 0, 0, 0); border-radius: 4px; padding: 10px; }
.vit-card:hover { border-color: rgba(255, 255, 255, 0.035); }
.vit-card.comp { border-color: rgba(255, 255, 255, 0.12); }
.vit-card .midia { height: 200px; }
.vit-corpo { padding: 12px 4px 4px 4px; }
.vit-attrs { flex-direction: row; margin: 12px 0 10px 0; }
.vit-at { flex-grow: 1; flex-basis: 0; align-items: center; }
.vit-at-rot { font-size: 12px; color: var(--apagado); -unity-text-align: middle-center; }
.vit-at-num { font-size: 16px; -unity-text-align: middle-center; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/IBMPlexMono-Medium.ttf"); }
.vit-preco { flex-direction: row; justify-content: space-between; align-items: center; padding: 8px 0 12px 0; border-top-width: 1px; border-top-color: rgba(255, 255, 255, 0.012); }
.vit-preco-v { font-size: 24px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/BarlowCondensed-SemiBold.ttf"); }
.vit-acoes { flex-direction: row; align-items: center; }
.vit-acoes > .btn-mini { padding: 8px 12px; }
.vit-acoes > .btn-mini.grow { flex-grow: 1; }
.vit-acoes > .btn-mini.so-ic { margin-left: 6px; padding: 8px 0; width: 38px; }

/* tabela do treino: colunas que cabem na janela mais estreita (4:3) sem se encavalar */
.c-j { width: 190px; } .c-foco { width: 130px; } .c-lado { width: 96px; } .c-sess { width: 128px; }
.c-bar { width: 112px; padding-right: 14px; }
.c-proj { flex-grow: 1; flex-shrink: 1; min-width: 0; }

/* texto sobre foto precisa de fundo próprio */
.midia .selo, .tj-foto .selo { background-color: rgba(8, 9, 12, 0.86); }
.seg { background-color: rgba(10, 12, 15, 0.98); }
.legenda-cal { margin-bottom: 10px; }

/* pré-partida: bonecos menores para não invadir o centro (chance, nomes) em janelas mais estreitas; dicas no centro, livres do boneco */
.pm-boneco { width: 440px; height: 591px; bottom: -215px; }
.pm-boneco.esq { left: 0; } .pm-boneco.dir { right: 0; }
.pm-dicas { left: 0; right: 0; justify-content: center; }

/* ======================================================================================================
   Playbook como quadro tático: alternador de lado, lista de jogadas, mapa animado, anéis e rotas
   ====================================================================================================== */
.pb-barra { flex-direction: row; justify-content: space-between; align-items: flex-end; margin: 20px 0 20px 0; border-bottom-width: 1px; border-bottom-color: rgba(255, 255, 255, 0.012); }
.pb-seg { flex-direction: row; }
.pb-seg-b { flex-direction: row; align-items: center; padding: 6px 4px 10px 0; margin-right: 34px; margin-bottom: -1px; border-bottom-width: 2px; border-bottom-color: rgba(0, 0, 0, 0); }
.pb-seg-b > .t { font-size: 32px; color: var(--apagado); -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/BarlowCondensed-SemiBold.ttf"); }
.pb-seg-b:hover > .t { color: var(--texto); }
.pb-seg-b.ativo { border-bottom-color: #eceef1; }
.pb-seg-b.ativo > .t { color: #ffffff; }
.pb-seg-q { width: 10px; height: 10px; border-radius: 2px; margin-right: 12px; }
.pb-seg-q.lado-tr { background-color: var(--laranja); } .pb-seg-q.lado-ct { background-color: var(--azul); }
.pb-vagas { flex-direction: row; padding-bottom: 12px; }
.pb-vaga { margin-left: 30px; }
.pb-pips { flex-direction: row; margin-top: 7px; }
.pb-pip { width: 20px; height: 8px; border-radius: 2px; margin-right: 4px; background-color: rgba(255, 255, 255, 0.012); border-width: 1px; border-color: rgba(255, 255, 255, 0.02); }
.pb-pip.on.fav { background-color: var(--verde); border-color: var(--verde); }
.pb-pip.on.proib { background-color: var(--vermelho); border-color: var(--vermelho); }

.pb-corpo { flex-direction: row; align-items: flex-start; }
.pb-lista { width: 380px; height: 820px; flex-shrink: 0; margin-right: 26px; }
.pb-linha { flex-direction: row; align-items: center; justify-content: space-between; padding: 11px 14px; margin-bottom: 4px; border-radius: 4px; border-width: 1px; border-color: rgba(0, 0, 0, 0); background-color: rgba(255, 255, 255, 0.004); }
.pb-linha:hover { background-color: rgba(255, 255, 255, 0.01); }
.pb-linha.sel { background-color: rgba(255, 255, 255, 0.016); border-color: rgba(255, 255, 255, 0.14); }
.pb-linha-esq { flex-grow: 1; flex-shrink: 1; min-width: 0; margin-right: 10px; }
.pb-linha-nome { font-size: 22px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/BarlowCondensed-SemiBold.ttf"); }
.pb-linha-nums { align-items: flex-end; flex-shrink: 0; }
.pb-linha-num { font-size: 17px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/IBMPlexMono-Medium.ttf"); }
.pb-linha-rot { font-size: 12px; color: var(--apagado); }

.pb-painel { flex-grow: 1; min-width: 0; }
.pb-topo { flex-direction: row; justify-content: space-between; align-items: flex-start; margin-bottom: 16px; }
.pb-nome { font-size: 48px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/BarlowCondensed-SemiBold.ttf"); }
.pb-stats { flex-direction: row; flex-wrap: wrap; padding: 18px 10px 14px 10px; margin-bottom: 20px; background-color: rgba(255, 255, 255, 0.006); border-radius: 4px; }
.pb-bloco { width: 132px; align-items: center; margin-right: 10px; }
.pb-anel-v { font-size: 22px; color: var(--texto); -unity-text-align: middle-center; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/IBMPlexMono-Medium.ttf"); }
.pb-num-caixa { width: 92px; height: 92px; align-items: center; justify-content: center; }
.pb-num { font-size: 44px; color: var(--texto); -unity-text-align: middle-center; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/BarlowCondensed-SemiBold.ttf"); }

.pb-miolo { flex-direction: row; flex-wrap: wrap; align-items: flex-start; }
.pb-quadro { margin-right: 26px; margin-bottom: 18px; width: 650px; }
.pb-planta { background-color: #0c0e11; border-width: 1px; border-color: rgba(255, 255, 255, 0.035); border-radius: 4px; }
.pb-site { font-size: 22px; -unity-text-align: middle-center; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/BarlowCondensed-SemiBold.ttf"); }
.pb-ctrl { flex-direction: row; align-items: center; margin-top: 12px; }
.pb-tempo { flex-grow: 1; height: 12px; margin: 0 14px; border-radius: 6px; background-color: rgba(255, 255, 255, 0.012); }
.pb-tempo-fill { height: 12px; border-radius: 6px; background-color: #eceef1; }
.pb-rel { font-size: 14px; color: var(--suave); min-width: 92px; -unity-text-align: middle-right; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/IBMPlexMono-Medium.ttf"); }
.pb-rod { flex-direction: row; align-items: center; margin: 12px 0 10px 0; }
.pb-lateral { flex-grow: 1; flex-basis: 280px; min-width: 260px; }
.pb-rota { flex-direction: row; align-items: flex-start; margin-top: 9px; }
.pb-rota-ponto { width: 10px; height: 10px; border-radius: 5px; margin: 5px 10px 0 0; flex-shrink: 0; }
.pb-item { flex-direction: row; align-items: flex-start; margin-top: 7px; }
.pb-item-q { width: 6px; height: 6px; border-radius: 1px; margin: 7px 10px 0 0; flex-shrink: 0; }
.pb-item-q.verde { background-color: var(--verde); } .pb-item-q.vermelho { background-color: var(--vermelho); }

/* playbook: indicadores na coluna lateral, ao lado do mapa */
.pb-stats { padding: 6px 0 2px 0; margin-bottom: 0; background-color: rgba(0, 0, 0, 0); }
.pb-bloco { width: 118px; margin-right: 6px; margin-bottom: 10px; }
.pb-topo { margin-bottom: 12px; }


/* ======================================================================================================
   Tela do campeonato (capa, resumo flutuante, abas) e leaderboard do ranking
   ====================================================================================================== */
.camp-capa { height: 240px; border-radius: 6px; overflow: hidden; background-color: #0c0e11; padding: 40px 38px; flex-shrink: 0; margin-top: 4px; }
.camp-titulo { font-size: 60px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/BarlowCondensed-SemiBold.ttf"); }
.camp-crumb { flex-direction: row; align-items: center; margin-top: 8px; }
.camp-crumb > .t { font-size: 14px; color: var(--suave); }
.camp-crumb > .camp-crumb-link:hover { color: #ffffff; }
.camp-crumb > .camp-crumb-sep { margin: 0 10px; color: var(--apagado); }
.camp-crumb > .camp-crumb-atual { color: #ffffff; }
.camp-resumo { flex-direction: row; flex-wrap: wrap; align-items: center; margin: -78px 30px 0 30px; padding: 26px 30px; background-color: #0e1013; border-radius: 6px; border-width: 1px; border-color: rgba(255, 255, 255, 0.03); flex-shrink: 0; }
.camp-r-esq { flex-grow: 1; flex-basis: 360px; min-width: 300px; margin-right: 20px; }
.camp-r-nome { font-size: 36px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/BarlowCondensed-SemiBold.ttf"); }
.camp-stat { align-items: center; padding: 4px 28px; border-left-width: 1px; border-left-color: rgba(255, 255, 255, 0.015); }
.camp-stat-v { font-size: 38px; -unity-text-align: middle-center; margin-top: 4px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/BarlowCondensed-SemiBold.ttf"); }
.camp-link { margin-top: 4px; }
.camp-acao { align-items: center; padding: 4px 0 4px 28px; border-left-width: 1px; border-left-color: rgba(255, 255, 255, 0.015); min-width: 240px; }
.camp-contagem { font-size: 58px; -unity-text-align: middle-center; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/BarlowCondensed-SemiBold.ttf"); }

.camp-visao { flex-direction: row; flex-wrap: wrap; align-items: flex-start; margin-top: 8px; }
.camp-col-principal { flex-grow: 2; flex-basis: 520px; min-width: 0; margin-right: 22px; }
.camp-col-lado { flex-grow: 1; flex-basis: 300px; min-width: 280px; }
.camp-card { background-color: rgba(255, 255, 255, 0.006); border-radius: 6px; padding: 24px 26px; margin-bottom: 18px; }
.camp-card-tit { font-size: 28px; margin-bottom: 12px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/BarlowCondensed-SemiBold.ttf"); }
.camp-txt { font-size: 15px; color: var(--suave); }
.camp-sub { font-size: 21px; margin: 22px 0 6px 0; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/BarlowCondensed-SemiBold.ttf"); }
.camp-dado { flex-direction: row; justify-content: space-between; margin-bottom: 8px; }
.camp-mini { flex-direction: row; align-items: center; padding: 8px 10px; border-radius: 4px; margin-bottom: 6px; background-color: rgba(255, 255, 255, 0.004); }
.camp-mini.meu { background-color: rgba(240, 166, 64, 0.014); }
.camp-mini-pos { width: 38px; font-size: 13px; color: var(--apagado); }
.pb-item-q.neutro { background-color: var(--apagado); }

.camp-linha-cab { flex-direction: row; align-items: center; padding: 12px 20px; margin-top: 14px; }
.camp-linha-cab > .t { font-size: 13px; color: var(--apagado); }
.camp-linha { flex-direction: row; align-items: center; height: 54px; padding: 0 20px; margin-bottom: 6px; border-radius: 4px; background-color: rgba(255, 255, 255, 0.004); }
.camp-linha:hover { background-color: rgba(255, 255, 255, 0.008); }
.camp-linha.meu { background-color: rgba(240, 166, 64, 0.014); }
.camp-c1 { width: 240px; } .camp-c2 { flex-grow: 1; flex-basis: 0; }
.camp-p1 { flex-grow: 2; flex-basis: 0; min-width: 0; } .camp-p2 { flex-grow: 1; flex-basis: 0; } .camp-p3 { width: 96px; }
.camp-mono { -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/IBMPlexMono-Medium.ttf"); }
.camp-topo-aba { margin-top: 22px; }

.camp-jogos { padding: 8px 0; margin-top: 8px; }
.camp-rodada { font-size: 12px; letter-spacing: 1.2px; color: var(--apagado); margin: 20px 22px 8px 22px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); }
.camp-jogo { flex-direction: row; align-items: center; height: 56px; padding: 0 22px; border-top-width: 1px; border-top-color: rgba(255, 255, 255, 0.008); }
.camp-jogo.meu { background-color: rgba(240, 166, 64, 0.014); }
.camp-jogo-data { width: 110px; font-size: 13px; color: var(--apagado); }
.camp-jogo-a { flex-grow: 1; flex-basis: 0; -unity-text-align: middle-right; }
.camp-jogo-b { flex-grow: 1; flex-basis: 0; }
.camp-jogo-placar { width: 110px; font-size: 18px; -unity-text-align: middle-center; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/IBMPlexMono-Medium.ttf"); }
.camp-jogo-est { width: 130px; align-items: flex-end; }

.camp-chave { margin-top: 24px; flex-shrink: 0; }
.camp-chave-cab { position: absolute; top: 0; height: 44px; }
.camp-chave-tit { font-size: 22px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/BarlowCondensed-SemiBold.ttf"); }
.camp-chave-card { background-color: rgba(255, 255, 255, 0.008); border-radius: 4px; border-width: 1px; border-color: rgba(255, 255, 255, 0.02); justify-content: center; }
.camp-chave-card.meu { border-color: rgba(240, 166, 64, 0.5); }
.camp-chave-lado { flex-direction: row; align-items: center; justify-content: space-between; height: 31px; padding: 0 12px; }
.camp-chave-nome { font-size: 14px; flex-shrink: 1; overflow: hidden; }
.camp-chave-v { font-size: 15px; margin-left: 8px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/IBMPlexMono-Medium.ttf"); }

.rk-c1 { width: 90px; } .rk-c2 { flex-grow: 1; flex-basis: 0; min-width: 0; } .rk-c3 { width: 190px; } .rk-c4 { width: 100px; } .rk-c5 { width: 160px; }
.rk-lin { height: 62px; }
.rk-av { width: 34px; height: 34px; border-radius: 17px; margin-right: -10px; border-width: 2px; border-color: #0b0d10; }
.rk-av > .t { font-size: 15px; }
.camp-paginas { flex-direction: row; justify-content: flex-end; margin-top: 18px; }
.camp-pag { width: 38px; height: 38px; border-radius: 19px; align-items: center; justify-content: center; margin-left: 6px; }
.camp-pag:hover { background-color: rgba(255, 255, 255, 0.012); }
.camp-pag.on { background-color: #eceef1; }
.camp-pag.on > .t { color: #0b0d10; }

/* ======================================================================================================
   Negociação: lista de conversas, balões, caixa de proposta e o que pesa para o jogador
   ====================================================================================================== */
.neg-corpo { flex-direction: row; align-items: flex-start; margin-top: 4px; }
.neg-lista { width: 340px; height: 650px; flex-shrink: 0; margin-right: 22px; }
.neg-linha { flex-direction: row; align-items: center; padding: 12px 14px; margin-bottom: 6px; border-radius: 6px; background-color: rgba(255, 255, 255, 0.005); }
.neg-linha:hover { background-color: rgba(255, 255, 255, 0.01); }
.neg-linha.sel { background-color: rgba(255, 255, 255, 0.016); }
.neg-foto { width: 48px; height: 48px; border-radius: 24px; flex-shrink: 0; }
.neg-foto-g { width: 58px; height: 58px; border-radius: 29px; flex-shrink: 0; }
.neg-foto-p { width: 36px; height: 36px; border-radius: 18px; flex-shrink: 0; margin-right: 12px; }
.neg-linha-meio { flex-grow: 1; flex-shrink: 1; min-width: 0; margin-left: 12px; }
.neg-linha-topo { flex-direction: row; justify-content: space-between; }
.neg-ponto { position: absolute; left: 50px; top: 48px; width: 12px; height: 12px; border-radius: 6px; background-color: var(--verde); border-width: 2px; border-color: #0b0d10; }
.neg-ponto.off { background-color: var(--apagado); }
.neg-conversa { flex-grow: 1; flex-basis: 0; min-width: 0; height: 650px; margin-right: 22px; background-color: rgba(255, 255, 255, 0.006); border-radius: 6px; }
.neg-topo { flex-direction: row; align-items: center; padding: 20px 24px; border-bottom-width: 1px; border-bottom-color: rgba(255, 255, 255, 0.012); }
.neg-nome { font-size: 32px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/BarlowCondensed-SemiBold.ttf"); }
.neg-msgs { flex-grow: 1; padding: 0 22px 12px 22px; }
.neg-balao-linha { flex-direction: row; align-items: flex-end; margin-top: 14px; }
.neg-balao-linha.nos { justify-content: flex-end; }
.neg-balao { max-width: 68%; flex-shrink: 1; background-color: rgba(255, 255, 255, 0.012); border-radius: 12px; padding: 12px 16px; }
.neg-balao.nos { background-color: rgba(240, 166, 64, 0.07); }
.neg-hora { font-size: 12px; color: var(--apagado); margin: 0 10px 4px 10px; }
.neg-sistema { align-self: center; margin: 18px 0 4px 0; padding: 8px 16px; border-radius: 4px; background-color: rgba(75, 191, 140, 0.08); }
.neg-oferta { padding: 16px 22px 18px 22px; border-top-width: 1px; border-top-color: rgba(255, 255, 255, 0.012); }
.neg-passos { flex-direction: row; flex-wrap: wrap; align-items: flex-end; }
.neg-passo { margin-right: 26px; margin-bottom: 10px; }
.neg-valor { font-size: 28px; min-width: 130px; -unity-text-align: middle-center; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/BarlowCondensed-SemiBold.ttf"); }
.neg-rodape { flex-direction: row; align-items: center; margin-top: 4px; }
.neg-fatores { width: 300px; flex-shrink: 0; background-color: rgba(255, 255, 255, 0.006); border-radius: 6px; padding: 22px; }
.neg-interesse { font-size: 38px; margin: 4px 0 16px 0; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/BarlowCondensed-SemiBold.ttf"); }
.neg-fator { margin-bottom: 14px; }
.neg-fator-topo { flex-direction: row; justify-content: space-between; align-items: center; }
.neg-ficha { margin-top: 10px; padding: 14px 0 12px 0; border-top-width: 1px; border-top-color: rgba(255, 255, 255, 0.012); }
.neg-rodape { flex-direction: column; align-items: stretch; }
.neg-botoes { flex-direction: row; justify-content: flex-end; margin-top: 10px; }

/* retratos: rosto de estúdio com a luz do lado forte por cima */
.retrato { overflow: hidden; }
.retrato-rim { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }

/* ======================================================================================================
   Pré-partida como quadro de confronto: times lado a lado com retratos, anel de chance no centro
   ====================================================================================================== */
.prematch { background-color: #0b0d10; border-width: 0; border-radius: 0; background-image: url("/Assets/Resources/ManagerUI/fundo.jpg"); background-size: cover; background-position: center center; -unity-background-image-tint-color: rgb(80, 80, 84); }
.pm2-topo { align-items: center; padding: 28px 0 0 0; }
.pm2-rel { flex-direction: row; align-items: center; padding: 9px 20px; border-radius: 4px; background-color: rgba(255, 255, 255, 0.008); }
.pm2-rel > .ic { margin-right: 10px; color: var(--suave); }
.pm2-rel > .t { font-size: 20px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/BarlowCondensed-SemiBold.ttf"); }
.pm2-corpo { flex-grow: 1; flex-direction: row; justify-content: center; align-items: flex-start; padding: 30px 48px 0 48px; }
.pm2-lado { width: 410px; flex-shrink: 1; }
.pm2-cab { flex-direction: row; align-items: center; margin-bottom: 20px; }
.pm2-lado.dir .pm2-cab { flex-direction: row-reverse; }
.pm2-brasao { width: 66px; height: 66px; border-radius: 4px; }
.pm2-brasao > .t { font-size: 40px; }
.pm2-tx { margin: 0 16px; flex-grow: 1; flex-shrink: 1; min-width: 0; }
.pm2-lado.dir .pm2-tx { align-items: flex-end; }
.pm2-nome { font-size: 48px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/BarlowCondensed-SemiBold.ttf"); }
.pm2-sub { font-size: 13px; letter-spacing: 1.2px; color: var(--apagado); }
.pm2-forca { align-items: center; }
.pm2-forca-v { font-size: 50px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/BarlowCondensed-SemiBold.ttf"); }
.pm2-j { flex-direction: row; align-items: center; padding: 8px 14px; margin-bottom: 7px; border-radius: 6px; background-color: rgba(255, 255, 255, 0.006); }
.pm2-lado.dir .pm2-j { flex-direction: row-reverse; }
.pm2-foto { width: 54px; height: 54px; border-radius: 27px; flex-shrink: 0; }
.pm2-j-tx { flex-grow: 1; margin: 0 16px; }
.pm2-lado.dir .pm2-j-tx { align-items: flex-end; }
.pm2-j-nome { font-size: 30px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/BarlowCondensed-SemiBold.ttf"); }
.pm2-j-ovr { font-size: 22px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/IBMPlexMono-Medium.ttf"); }
.pm2-centro { width: 330px; flex-shrink: 0; align-items: center; margin: 0 34px; padding-top: 18px; }
.pm2-anel-v { font-size: 74px; color: var(--texto); -unity-text-align: middle-center; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/BarlowCondensed-SemiBold.ttf"); }
.pm2-duelo { flex-direction: row; align-items: center; justify-content: space-between; align-self: stretch; margin-top: 22px; }
.pm2-duelo-v { font-size: 30px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/IBMPlexMono-Medium.ttf"); }
.pm2-centro .pm-chance-barra { align-self: stretch; margin: 10px 0 12px 0; }
.pm2-chance-sub { font-size: 15px; color: var(--suave); -unity-text-align: middle-center; }
.pm2-barra { flex-direction: row; justify-content: center; align-items: center; flex-wrap: wrap; padding: 0 48px 18px 48px; }
.pm2-acoes { flex-direction: row; }
.pm2-acoes > .btn { margin: 0 6px; }
.pm2-comecar { min-width: 320px; margin: 0 26px; }
.prematch .pm-dicas { position: relative; left: 0; right: 0; bottom: auto; justify-content: center; padding-bottom: 20px; }
.pm2-j { padding: 11px 20px; margin-bottom: 11px; }
.pm2-foto { width: 74px; height: 74px; border-radius: 37px; }
.pm2-j-nome { font-size: 36px; }
.pm2-j-ovr { font-size: 28px; }
.pm2-anel-v { font-size: 84px; }
.pm2-lado { width: 430px; }

/* ======================================================================================================
   Primeiros passos (tour guiado): cartão no canto e brilho no menu
   ====================================================================================================== */
.tut { position: absolute; right: 30px; bottom: 30px; width: 410px; padding: 20px 22px 18px 22px; background-color: #0e1013; border-radius: 6px; border-width: 1px; border-color: rgba(255, 255, 255, 0.05); }
.tut-topo { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 10px; }
.tut-pips { flex-direction: row; }
.tut-pip { width: 16px; height: 4px; border-radius: 2px; margin-left: 4px; background-color: rgba(255, 255, 255, 0.012); }
.tut-pip.on { background-color: #eceef1; }
.tut-titulo { font-size: 32px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/BarlowCondensed-SemiBold.ttf"); }
.tut-texto { font-size: 15px; color: var(--suave); margin: 6px 0 16px 0; }
.tut-botoes { flex-direction: row; align-items: center; }
.item.pulso { border-width: 1px; border-color: rgba(0, 0, 0, 0); transition-property: border-color, background-color; transition-duration: 500ms; }
.item.pulso.pulso-alto { border-color: rgba(255, 255, 255, 0.12); background-color: rgba(255, 255, 255, 0.012); }

/* ---- opções (decisão 0030) ---- */
.opc-linha { flex-direction: row; align-items: center; justify-content: space-between; padding-top: 14px; padding-bottom: 14px; border-top-width: 1px; border-top-color: rgba(255, 255, 255, 0.02); }
.opc-linha:first-child { border-top-width: 0; }
.opc-esq { flex-shrink: 1; flex-grow: 1; margin-right: 24px; }
.opc-chips { flex-direction: row; flex-shrink: 0; }
.opc-chips-g { flex-direction: row; flex-shrink: 0; }
.opc-chips-g > .btn-mini { margin-left: 8px; }
.opc-chips > .btn-mini { margin-left: 8px; }

/* ---- duas colunas (finanças, Gaming House, scouts) ---- */
.cols2 { flex-direction: row; margin-right: -18px; margin-bottom: 0px; }
.cols2 > * { flex-grow: 1; flex-basis: 0; margin-right: 18px; }
.fin-pecas { flex-direction: row; margin-right: -14px; margin-bottom: 18px; }
.fin-peca { flex-grow: 1; flex-basis: 0; margin-right: 14px; padding: 16px 18px; border-radius: 4px; background-color: rgba(255, 255, 255, 0.004); border-width: 1px; border-color: rgba(255, 255, 255, 0.02); }
.fin-valor { font-size: 30px; margin-top: 6px; margin-bottom: 4px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/BarlowCondensed-SemiBold.ttf"); }
.fin-cartao { padding: 20px 22px; }
.fin-fluxo { flex-direction: row; align-items: center; height: 40px; }
.fin-fluxo.total { margin-top: 6px; border-top-width: 1px; border-top-color: rgba(255, 255, 255, 0.02); }
.fin-rot { width: 190px; font-size: 15px; }
.fin-trilho { flex-grow: 1; height: 6px; margin-left: 10px; margin-right: 14px; }
.fin-barra { height: 6px; border-radius: 3px; }
.fin-barra.pos { background-color: rgba(75, 191, 140, 0.337); }
.fin-barra.neg { background-color: rgba(236, 106, 95, 0.337); }
.fin-val { width: 100px; -unity-text-align: middle-right; font-size: 15px; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/IBMPlexMono-Medium.ttf"); }
.fin-emp { flex-direction: row; align-items: center; padding-top: 10px; padding-bottom: 10px; border-top-width: 1px; border-top-color: rgba(255, 255, 255, 0.02); }
.fin-pegar { margin-top: 16px; margin-bottom: 8px; }
.fin-lin { flex-direction: row; align-items: center; height: 40px; border-top-width: 1px; border-top-color: rgba(255, 255, 255, 0.02); }
.fin-lin > .t { white-space: normal; }
.gh-trilha { flex-direction: row; margin-bottom: 22px; padding: 18px 22px 14px 22px; border-radius: 4px; background-color: rgba(255, 255, 255, 0.004); border-width: 1px; border-color: rgba(255, 255, 255, 0.02); }
.gh-passo { flex-grow: 1; flex-basis: 0; }
.gh-passo.ultimo { flex-grow: 0; flex-basis: auto; width: 120px; }
.gh-passo-topo { flex-direction: row; align-items: center; }
.gh-passo .gh-num { margin-right: 0px; }
.gh-liga { flex-grow: 1; height: 2px; margin-left: 8px; margin-right: 8px; background-color: rgba(255, 255, 255, 0.02); }
.gh-passo.feito .gh-liga { background-color: #eceef1; }
.gh-passo.feito .gh-num { background-color: rgba(255, 255, 255, 0.04); }
.gh-passo.atual .gh-num { background-color: #eceef1; }
.gh-passo.atual .gh-num > .t { color: #0b0d10; }
.gh-passo-nome { margin-top: 8px; font-size: 14px; color: var(--apagado); white-space: normal; }
.gh-passo.atual .gh-passo-nome { color: #ffffff; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/Barlow-SemiBold.ttf"); }
.gh-passo.feito .gh-passo-nome { color: var(--suave); }
.f22 { font-size: 22px; }

/* ---- carregando a partida (decisão 0031) ---- */
.carregando { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: #0b0d10; align-items: center; justify-content: center; opacity: 0; transition-property: opacity; transition-duration: 0.25s; }
.carregando.visivel { opacity: 1; }
.car-peq { font-size: 16px; color: #f5a524; letter-spacing: 3px; margin-bottom: 8px; }
.car-tit { font-size: 72px; color: #ffffff; -unity-font-definition: url("/Assets/Resources/ManagerUI/Fontes/BarlowCondensed-SemiBold.ttf"); white-space: normal; -unity-text-align: middle-center; }
.car-sub { font-size: 20px; color: #9fa6b0; margin-top: 6px; -unity-text-align: middle-center; }
.car-trilho { width: 360px; height: 3px; margin-top: 40px; margin-bottom: 14px; background-color: rgba(255, 255, 255, 0.02); overflow: hidden; }
.car-seg { position: absolute; top: 0; width: 110px; height: 3px; background-color: #eceef1; }

/* ---- pós-partida e hub (decisão 0033) ---- */
.hero { border-left-width: 4px; padding: 22px 30px; }
.hero.venceu { border-left-color: var(--verde); }
.hero.perdeu { border-left-color: var(--vermelho); }
.hero-lado { flex-grow: 1; flex-basis: 0; min-width: 0; }
.hero-dir { align-items: flex-end; }
.hero-meio { flex-shrink: 0; margin: 0 24px; }
.pp-mapas { flex-direction: row; margin-top: 8px; }
.pp-mapas > .selo { margin-left: 6px; }
.pp-dest { padding: 14px 20px; margin-bottom: 0; }
.pp-dest .cartao-tit { margin-bottom: 8px; }
.pp .c-j.largo { width: 300px; flex-shrink: 0; }
.pp .c-n { width: auto; flex-grow: 1; flex-basis: 0; }
.pp .tr { height: 50px; }
.pp .tr.th { height: 38px; }
.pp .tr.mvp { background-color: rgba(76, 195, 138, 0.02); }
.hub-tit.longo { font-size: 28px; }
.diario-sem { width: 44px; flex-shrink: 0; font-size: 13px; color: var(--apagado); }

/* ---- folha do contrato (decisão 0042): um papel de verdade sobre a tela escurecida ---- */
.contrato-cena { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(4, 5, 7, 0.86); align-items: center; justify-content: center; opacity: 0; transition-property: opacity; transition-duration: 0.18s; padding: 24px 0; }
.contrato-cena.visivel { opacity: 1; }
.contrato-rolo { flex-shrink: 1; max-height: 86%; width: 620px; max-width: 94%; }
.contrato-barra { flex-direction: row; justify-content: center; margin-top: 16px; flex-shrink: 0; }
.folha { background-color: #f1ecdf; padding: 38px 46px 30px 46px; border-radius: 2px; border-width: 1px; border-color: #cfc7b2; }
.folha Label { color: #23201a; white-space: normal; }
.folha-carimbo { position: absolute; right: 38px; top: 34px; border-width: 3px; border-radius: 4px; padding: 3px 12px; rotate: -9deg; }
.folha-carimbo.minuta { border-color: #b8590f; }
.folha-carimbo.assinado { border-color: #2f7d4f; }
.folha .folha-carimbo-t { font-size: 17px; -unity-font-style: bold; letter-spacing: 3px; }
.folha-carimbo.minuta > .folha-carimbo-t { color: #b8590f; }
.folha-carimbo.assinado > .folha-carimbo-t { color: #2f7d4f; }
.folha .folha-tit { font-size: 25px; -unity-font-style: bold; letter-spacing: 2px; margin-right: 150px; }
.folha .folha-sub { font-size: 15px; color: #5b5648; margin-top: 2px; }
.folha .folha-num { font-size: 12px; color: #6d6757; margin-top: 8px; letter-spacing: 1px; }
.folha-regua { height: 2px; background-color: #23201a; margin-top: 14px; margin-bottom: 16px; }
.folha-partes { flex-direction: row; margin-bottom: 8px; }
.folha-parte { flex-grow: 1; flex-basis: 0; margin-right: 20px; }
.folha .folha-rot { font-size: 11px; color: #6d6757; letter-spacing: 2px; -unity-font-style: bold; }
.folha .folha-nome { font-size: 20px; -unity-font-style: bold; margin-top: 2px; }
.folha .folha-det { font-size: 12px; color: #5b5648; margin-top: 2px; }
.folha-cl { margin-top: 12px; padding-top: 10px; border-top-width: 1px; border-color: rgba(35, 32, 26, 0.22); }
.folha-cl.alerta { background-color: rgba(184, 89, 15, 0.12); padding: 10px 12px; border-top-width: 0; border-left-width: 4px; border-color: #b8590f; }
.folha .folha-cl-tit { font-size: 12px; -unity-font-style: bold; letter-spacing: 2px; color: #4a4638; }
.folha .folha-cl-txt { font-size: 15px; margin-top: 3px; }
.folha-assinaturas { flex-direction: row; margin-top: 30px; }
.folha-ass { flex-grow: 1; flex-basis: 0; margin-right: 24px; }
.folha-ass-linha { height: 34px; border-bottom-width: 1px; border-color: #23201a; justify-content: flex-end; margin-bottom: 5px; }
.folha .folha-ass-nome { font-size: 19px; -unity-font-style: italic; color: #1b2f5e; }
.folha .folha-rodape { font-size: 12px; color: #6d6757; margin-top: 20px; }
